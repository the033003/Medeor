:root {
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #eceef2;
  background: #0b0c0f;

  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

* {
  box-sizing: border-box;
}

html,
body,
#app {
  width: 100%;
  height: 100%;
  margin: 0;
}

body {
  overflow: hidden;
  background:
    radial-gradient(
      circle at 75% 15%,
      rgba(116, 88, 255, 0.07),
      transparent 30%
    ),
    #0b0c0f;
}

button,
input {
  font: inherit;
}

button {
  border: 0;
}

.app-shell {
  display: flex;
  width: 100%;
  height: 100%;
}

.sidebar {
  width: 248px;
  min-width: 248px;
  height: 100%;
  display: flex;
  flex-direction: column;
  padding: 24px 16px 16px;
  border-right: 1px solid #202229;
  background: rgba(13, 14, 18, 0.92);
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 4px 10px 30px;
}

.brand-mark {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  color: #ffffff;
  background:
    linear-gradient(
      135deg,
      #8068ff,
      #5741d8
    );
  box-shadow:
    0 8px 30px rgba(101, 79, 240, 0.22);
  font-size: 18px;
}

.brand-name {
  color: #f3f3f6;
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.brand-subtitle {
  margin-top: 2px;
  color: #777b87;
  font-size: 11px;
}

.navigation {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 11px;
  width: 100%;
  padding: 10px 11px;
  border-radius: 8px;
  color: #8d919c;
  background: transparent;
  text-align: left;
  cursor: pointer;
  transition:
    background 120ms ease,
    color 120ms ease;
}

.nav-item:hover {
  color: #dfe1e7;
  background: #16171d;
}

.nav-item.active {
  color: #f1efff;
  background: rgba(104, 83, 226, 0.15);
}

.nav-icon {
  width: 17px;
  color: #777b87;
  text-align: center;
}

.nav-item.active .nav-icon {
  color: #a99aff;
}

.sidebar-section {
  margin-top: 34px;
}

.sidebar-heading {
  padding: 0 11px 9px;
  color: #60646e;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.tag-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 8px 11px;
  border-radius: 7px;
  color: #8c909b;
  background: transparent;
  font-size: 13px;
  text-align: left;
  cursor: pointer;
}

.tag-row:hover {
  color: #dfe1e7;
  background: #16171d;
}

.tag-count {
  color: #555964;
  font-size: 11px;
}

.sidebar-footer {
  margin-top: auto;
}

.settings-button {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 10px 11px;
  border-radius: 8px;
  color: #70747e;
  background: transparent;
  cursor: pointer;
}

.settings-button:hover {
  color: #dfe1e7;
  background: #16171d;
}

.main {
  min-width: 0;
  flex: 1;
  height: 100%;
  overflow: hidden;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 94px;
  padding: 0 34px;
  border-bottom: 1px solid #1c1e24;
}

.eyebrow {
  margin-bottom: 4px;
  color: #626672;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.14em;
}

h1 {
  margin: 0;
  color: #f0f1f4;
  font-size: 22px;
  font-weight: 650;
  letter-spacing: -0.025em;
}

.search {
  display: flex;
  align-items: center;
  width: min(390px, 42vw);
  height: 38px;
  padding: 0 10px;
  border: 1px solid #252831;
  border-radius: 9px;
  background: #111217;
  color: #737781;
}

.search:focus-within {
  border-color: #4d4576;
  box-shadow: 0 0 0 3px rgba(99, 78, 207, 0.08);
}

.search-icon {
  margin-right: 7px;
  color: #656975;
  font-size: 19px;
}

.search input {
  min-width: 0;
  flex: 1;
  border: 0;
  outline: 0;
  color: #e8e9ed;
  background: transparent;
  font-size: 13px;
}

.search input::placeholder {
  color: #5c606b;
}

.search kbd {
  padding: 2px 6px;
  border: 1px solid #292c34;
  border-radius: 5px;
  color: #5d616b;
  background: #17181e;
  font-size: 10px;
}

.content {
  width: 100%;
  height: calc(100% - 94px);
  overflow: auto;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding-bottom: 8vh;
  text-align: center;
}

.empty-orbit {
  display: grid;
  place-items: center;
  width: 96px;
  height: 96px;
  margin-bottom: 25px;
  border: 1px solid #2a2c35;
  border-radius: 50%;
  background:
    radial-gradient(
      circle,
      rgba(109, 87, 230, 0.14),
      rgba(109, 87, 230, 0.025) 65%,
      transparent 70%
    );
  box-shadow:
    0 0 80px rgba(91, 70, 204, 0.08);
}

.empty-mark {
  color: #9180f6;
  font-size: 31px;
}

.empty-state h2 {
  margin: 0;
  color: #e6e7eb;
  font-size: 19px;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.empty-state p {
  max-width: 370px;
  margin: 9px 0 22px;
  color: #686c77;
  font-size: 13px;
  line-height: 1.6;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 38px;
  padding: 0 15px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition:
    transform 120ms ease,
    background 120ms ease;
}

.primary-button {
  color: #ffffff;
  background: #6754d8;
  box-shadow: 0 8px 24px rgba(93, 72, 207, 0.16);
}

.primary-button:hover {
  background: #7461e7;
  transform: translateY(-1px);
}

.secondary-button {
  color: #d5d7de;
  border: 1px solid #2b2e37;
  background: #17191f;
}

.secondary-button:hover {
  background: #1d2027;
}

.import-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 58px 34px;
}

.drop-zone {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: min(780px, 100%);
  min-height: 360px;
  padding: 50px;
  border: 1px dashed #343743;
  border-radius: 16px;
  background:
    radial-gradient(
      circle at center,
      rgba(105, 84, 216, 0.045),
      transparent 60%
    );
  text-align: center;
  cursor: pointer;
  transition:
    border-color 150ms ease,
    background 150ms ease;
}

.drop-zone:hover,
.drop-zone:focus {
  border-color: #6253a8;
  outline: none;
  background:
    radial-gradient(
      circle at center,
      rgba(105, 84, 216, 0.08),
      transparent 60%
    );
}

.drop-icon {
  display: grid;
  place-items: center;
  width: 52px;
  height: 52px;
  margin-bottom: 20px;
  border: 1px solid #30333d;
  border-radius: 13px;
  color: #9687ed;
  background: #15161c;
  font-size: 21px;
}

.drop-zone h2 {
  margin: 0;
  color: #e7e8ec;
  font-size: 18px;
  font-weight: 600;
}

.drop-zone p {
  margin: 8px 0 21px;
  color: #686c77;
  font-size: 13px;
}

.import-note {
  display: flex;
  gap: 12px;
  width: min(780px, 100%);
  margin-top: 16px;
  padding: 15px 17px;
  border: 1px solid #20232b;
  border-radius: 10px;
  background: #101115;
}

.note-icon {
  color: #8979e8;
}

.import-note strong {
  color: #bfc1c8;
  font-size: 12px;
  font-weight: 600;
}

.import-note p {
  margin: 4px 0 0;
  color: #656974;
  font-size: 12px;
  line-height: 1.5;
}

@media (max-width: 800px) {
  .sidebar {
    width: 205px;
    min-width: 205px;
  }

  .topbar {
    padding: 0 22px;
  }

  .search {
    width: 280px;
  }
}

.library-count {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 11px;
  color: #8c909b;
  font-size: 13px;
}

.library-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
  gap: 16px;
  padding: 28px 34px;
}

.media-card {
  min-width: 0;
  padding: 0;
  overflow: hidden;
  border: 1px solid #252831;
  border-radius: 12px;
  color: #e8e9ed;
  background: #111217;
  text-align: left;
  cursor: pointer;
  transition:
    border-color 140ms ease,
    transform 140ms ease,
    background 140ms ease;
}

.media-card:hover {
  border-color: #51468a;
  background: #15161d;
  transform: translateY(-2px);
}

.media-preview {
  display: grid;
  place-items: center;
  aspect-ratio: 16 / 10;
  color: #8f82e9;
  background:
    radial-gradient(
      circle at 50% 40%,
      rgba(104, 83, 226, 0.18),
      transparent 55%
    ),
    #0d0e12;
}

.media-type {
  display: grid;
  place-items: center;
  width: 48px;
  height: 48px;
  border: 1px solid #302e45;
  border-radius: 12px;
  background: #161620;
  font-size: 14px;
  font-weight: 700;
}

.media-info {
  padding: 12px 13px 14px;
}

.media-name {
  overflow: hidden;
  color: #dfe0e5;
  font-size: 13px;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.media-meta {
  margin-top: 5px;
  color: #626671;
  font-size: 11px;
}

.error-banner {
  margin: 18px 34px 0;
  padding: 11px 13px;
  border: 1px solid #5c3034;
  border-radius: 8px;
  color: #f0b9bd;
  background: rgba(111, 40, 46, 0.18);
  font-size: 12px;
}

.drop-zone.drag-active {
  border-color: #806cf1;
  background:
    radial-gradient(
      circle at center,
      rgba(105, 84, 216, 0.14),
      transparent 60%
    );
  box-shadow: 0 0 0 3px rgba(105, 84, 216, 0.08);
}

button:disabled {
  opacity: 0.55;
  cursor: wait;
}

/* =========================================================
   Library actions
   ========================================================= */

.library-toolbar {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
}

.media-card {
  position: relative;
  overflow: visible;
}

.media-open {
  width: 100%;
  border: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.media-menu {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 5;
}

.menu-button {
  width: 34px;
  height: 34px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 10px;
  background: rgba(15, 18, 25, .88);
  color: #fff;
  font-size: 21px;
  line-height: 1;
  cursor: pointer;
  backdrop-filter: blur(12px);
  transition: .15s ease;
}

.menu-button:hover {
  background: rgba(40, 44, 55, .95);
  transform: translateY(-1px);
}

.menu {
  position: absolute;
  top: 42px;
  right: 0;
  width: 190px;
  padding: 6px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 12px;
  background: #171a22;
  box-shadow: 0 18px 45px rgba(0,0,0,.4);
  z-index: 20;
}

.menu button {
  display: block;
  width: 100%;
  padding: 10px 12px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #e8eaf0;
  text-align: left;
  cursor: pointer;
}

.menu button:hover:not(:disabled) {
  background: rgba(255,255,255,.07);
}

.menu button:disabled {
  opacity: .4;
  cursor: not-allowed;
}

.menu .menu-danger {
  color: #ff8585;
}

.selection-box {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 10;
}

.selection-box input {
  width: 19px;
  height: 19px;
  accent-color: #a78bfa;
  cursor: pointer;
}

.media-card.selected {
  outline: 2px solid #a78bfa;
  outline-offset: 2px;
}

.danger-button {
  border: 1px solid rgba(255, 90, 90, .22);
  border-radius: 10px;
  padding: 9px 13px;
  background: rgba(255, 75, 75, .1);
  color: #ff8585;
  font: inherit;
  cursor: pointer;
  transition: .15s ease;
}

.danger-button:hover:not(:disabled) {
  background: rgba(255, 75, 75, .18);
  border-color: rgba(255, 90, 90, .35);
}

.danger-button:disabled {
  opacity: .4;
  cursor: not-allowed;
}

/* =========================================================
   Delete modal
   ========================================================= */

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(5, 7, 12, .72);
  backdrop-filter: blur(8px);
  animation: modal-fade .15s ease;
}

.delete-modal {
  width: min(440px, 100%);
  padding: 26px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 20px;
  background: #171a22;
  box-shadow: 0 30px 90px rgba(0,0,0,.5);
  animation: modal-pop .16s ease;
}

.delete-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  margin-bottom: 18px;
  border-radius: 14px;
  background: rgba(255, 75, 75, .12);
  color: #ff7777;
  font-size: 24px;
}

.delete-content h2 {
  margin: 0 0 8px;
  color: #fff;
  font-size: 21px;
}

.delete-content p {
  margin: 0;
  color: #969ba8;
  line-height: 1.5;
}

.delete-filename {
  overflow: hidden;
  margin-top: 16px;
  padding: 11px 13px;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 10px;
  background: rgba(255,255,255,.035);
  color: #dfe2e9;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 24px;
}

.modal-delete {
  padding: 10px 15px;
}

@keyframes modal-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes modal-pop {
  from {
    opacity: 0;
    transform: scale(.97) translateY(5px);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

/* =========================================================
   Medeor media viewer
   ========================================================= */

.viewer {
  position: fixed;
  inset: 0;
  z-index: 900;
  display: flex;
  flex-direction: column;
  background: #090b10;
  color: #fff;
}

.viewer-header {
  display: flex;
  align-items: center;
  min-height: 64px;
  padding: 0 20px;
  border-bottom: 1px solid rgba(255,255,255,.07);
  background: rgba(12,14,20,.94);
  backdrop-filter: blur(18px);
}

.viewer-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  margin-right: 14px;
  border: 0;
  border-radius: 10px;
  background: rgba(255,255,255,.06);
  color: #fff;
  font-size: 28px;
  cursor: pointer;
}

.viewer-close:hover {
  background: rgba(255,255,255,.11);
}

.viewer-title {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.viewer-title strong {
  overflow: hidden;
  max-width: 600px;
  font-size: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.viewer-title span {
  margin-top: 2px;
  color: #7f8593;
  font-size: 12px;
}

.viewer-header-spacer {
  flex: 1;
}

.viewer-stage {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 0;
  overflow: hidden;
  background:
    radial-gradient(circle at center, rgba(105, 90, 180, .07), transparent 45%),
    #090b10;
}

.viewer-media {
  display: block;
  max-width: calc(100% - 48px);
  max-height: calc(100% - 48px);
  object-fit: contain;
}

.viewer-image {
  width: auto;
  height: auto;
}

.viewer-stage:fullscreen {
  background: #000;
}

.viewer-stage:fullscreen .viewer-media {
  max-width: 100%;
  max-height: 100%;
}

.viewer-controls {
  position: absolute;
  right: 22px;
  bottom: 18px;
  left: 22px;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 14px;
  background: rgba(16,18,25,.9);
  box-shadow: 0 14px 45px rgba(0,0,0,.35);
  backdrop-filter: blur(16px);
}

.viewer-control {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: #fff;
  cursor: pointer;
}

.viewer-control:hover {
  background: rgba(255,255,255,.08);
}

.viewer-time {
  min-width: 42px;
  color: #aeb3bf;
  font-size: 12px;
  font-variant-numeric: tabular-nums;
  text-align: center;
}

.viewer-progress {
  min-width: 80px;
  flex: 1;
  accent-color: #a78bfa;
}

.viewer-volume {
  width: 90px;
  accent-color: #a78bfa;
}

.viewer-fullscreen {
  position: absolute;
  right: 20px;
  top: 20px;
  width: 40px;
  height: 40px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 10px;
  background: rgba(16,18,25,.8);
  color: #fff;
  font-size: 18px;
  cursor: pointer;
  backdrop-filter: blur(10px);
}

.viewer-fullscreen:hover {
  background: rgba(255,255,255,.12);
}

/* =========================================================
   Real media previews
   ========================================================= */

.media-preview {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(167,139,250,.09), rgba(65,75,105,.12)),
    #10131a;
}

.media-preview img,
.media-preview video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.preview-video {
  pointer-events: none;
}

/* =========================================================
   Native drag/drop visual state
   ========================================================= */

.drop-zone.drag-active {
  border-color: #a78bfa;
  background:
    radial-gradient(circle at center, rgba(167,139,250,.13), transparent 65%),
    rgba(167,139,250,.05);
  box-shadow:
    0 0 0 3px rgba(167,139,250,.08),
    0 20px 60px rgba(0,0,0,.2);
  transform: scale(1.01);
}

.drop-zone {
  transition:
    border-color .15s ease,
    background .15s ease,
    box-shadow .15s ease,
    transform .15s ease;
}

/* =========================================================
   Real library media previews
   ========================================================= */

.media-preview {
  position: relative;
  overflow: hidden;
  background: #10131a;
}

.media-preview img,
.media-preview video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.preview-video {
  pointer-events: none;
}

.preview-play {
  position: absolute;
  left: 50%;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 50%;
  background: rgba(10,12,17,.72);
  color: white;
  font-size: 14px;
  transform: translate(-50%, -50%);
  backdrop-filter: blur(8px);
  pointer-events: none;
}


/* =========================================================
   Medeor viewer window
   ========================================================= */

.viewer-window {
  position: fixed;
  inset: 0;
  display: flex;
  flex-direction: column;
  background: #090b10;
  color: #fff;
}

.viewer-header {
  display: flex;
  align-items: center;
  min-height: 60px;
  padding: 0 20px;
  border-bottom: 1px solid rgba(255,255,255,.07);
  background: rgba(14,16,22,.96);
  backdrop-filter: blur(16px);
}

.viewer-heading {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.viewer-heading strong {
  overflow: hidden;
  max-width: 750px;
  font-size: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.viewer-heading span {
  margin-top: 3px;
  color: #7f8593;
  font-size: 12px;
}

.viewer-stage {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  min-height: 0;
  overflow: hidden;
  background:
    radial-gradient(
      circle at center,
      rgba(110, 90, 190, .07),
      transparent 48%
    ),
    #090b10;
}

.viewer-stage:fullscreen {
  background: #000;
}

.viewer-media {
  display: block;
  max-width: calc(100% - 48px);
  max-height: calc(100% - 48px);
  object-fit: contain;
}

.viewer-stage:fullscreen .viewer-media {
  max-width: 100%;
  max-height: 100%;
}

.viewer-controls {
  position: absolute;
  right: 20px;
  bottom: 18px;
  left: 20px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 10px 12px;
  border: 1px solid rgba(255,255,255,.09);
  border-radius: 14px;
  background: rgba(18,20,27,.92);
  box-shadow: 0 18px 50px rgba(0,0,0,.4);
  backdrop-filter: blur(18px);
}

.viewer-control {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: #fff;
  cursor: pointer;
}

.viewer-control:hover {
  background: rgba(255,255,255,.09);
}

.viewer-progress {
  min-width: 80px;
  flex: 1;
  accent-color: #a78bfa;
}

.viewer-volume {
  width: 90px;
  accent-color: #a78bfa;
}

.viewer-time {
  min-width: 42px;
  color: #aeb3bf;
  font-size: 12px;
  font-variant-numeric: tabular-nums;
  text-align: center;
}

.viewer-floating-control {
  position: absolute;
  top: 18px;
  right: 18px;
  width: 40px;
  height: 40px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 10px;
  background: rgba(18,20,27,.84);
  color: #fff;
  font-size: 18px;
  cursor: pointer;
  backdrop-filter: blur(10px);
}

.viewer-floating-control:hover {
  background: rgba(255,255,255,.12);
}

.viewer-error {
  color: #858b98;
}


/* =========================================================
   Library previews
   ========================================================= */

.media-preview {
  position: relative;
  overflow: hidden;
  width: 100%;
  aspect-ratio: 16 / 10;
  background:
    radial-gradient(
      circle at 50% 40%,
      rgba(105, 84, 220, .10),
      transparent 65%
    ),
    #10131a;
}

.media-preview img,
.media-preview video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition:
    transform .22s ease,
    filter .22s ease;
}

.media-card:hover .media-preview img,
.media-card:hover .media-preview video {
  transform: scale(1.035);
}

.preview-video {
  pointer-events: none;
}

.preview-play {
  position: absolute;
  left: 50%;
  top: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 50%;
  background: rgba(10,12,17,.72);
  color: #fff;
  font-size: 13px;
  transform: translate(-50%, -50%);
  backdrop-filter: blur(8px);
  pointer-events: none;
  opacity: .9;
  transition:
    transform .18s ease,
    background .18s ease;
}

.media-card:hover .preview-play {
  transform: translate(-50%, -50%) scale(1.08);
  background: rgba(10,12,17,.82);
}

.media-type {
  display: grid;
  place-items: center;
  width: 100%;
  height: 100%;
  color: #777b87;
  font-size: 28px;
}

.media-hover-info {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 28px 12px 11px;
  background:
    linear-gradient(
      to top,
      rgba(5,7,11,.94),
      rgba(5,7,11,.72) 45%,
      transparent
    );
  opacity: 0;
  transform: translateY(4px);
  transition:
    opacity .16s ease,
    transform .16s ease;
  pointer-events: none;
}

.media-card:hover .media-hover-info {
  opacity: 1;
  transform: translateY(0);
}

.media-name {
  overflow: hidden;
  color: #f1f2f5;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.media-hover-info .media-meta {
  margin-top: 3px;
  color: #a0a4ae;
  font-size: 10px;
  line-height: 1.3;
}

/* =========================================================
   Drag/drop
   ========================================================= */


.drop-zone {
  transition:
    border-color .15s ease,
    background .15s ease,
    box-shadow .15s ease,
    transform .15s ease;
}

.drop-zone.drag-active {
  border-color: #a78bfa;
  background:
    radial-gradient(
      circle at center,
      rgba(167,139,250,.13),
      transparent 65%
    ),
    rgba(167,139,250,.05);
  box-shadow:
    0 0 0 3px rgba(167,139,250,.08),
    0 20px 60px rgba(0,0,0,.2);
  transform: scale(1.01);
}


/* =========================================================
   Selection / menu
   ========================================================= */

.media-card {
  position: relative;
  overflow: visible;
}

.media-open {
  width: 100%;
  border: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  text-align: left;
  cursor: pointer;
}

.media-card.selected {
  outline: 2px solid #a78bfa;
  outline-offset: 2px;
}

.selection-box {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 10;
}

.selection-box input {
  width: 19px;
  height: 19px;
  accent-color: #a78bfa;
  cursor: pointer;
}

.library-toolbar {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 18px;
}

.media-menu {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 20;
}

.menu-button {
  width: 34px;
  height: 34px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 10px;
  background: rgba(15,18,25,.88);
  color: #fff;
  font-size: 21px;
  line-height: 1;
  cursor: pointer;
  backdrop-filter: blur(12px);
}

.menu-button:hover {
  background: rgba(40,44,55,.95);
}

.menu {
  position: absolute;
  top: 42px;
  right: 0;
  width: 190px;
  padding: 6px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 12px;
  background: #171a22;
  box-shadow: 0 18px 45px rgba(0,0,0,.4);
}

.menu button {
  display: block;
  width: 100%;
  padding: 10px 12px;
  border: 0;
  border-radius: 8px;
  background: transparent;
  color: #e8eaf0;
  text-align: left;
  cursor: pointer;
}

.menu button:hover:not(:disabled) {
  background: rgba(255,255,255,.07);
}

.menu button:disabled {
  opacity: .4;
  cursor: not-allowed;
}


/* =========================================================
   Remove dialog
   ========================================================= */

.danger-button {
  border: 1px solid rgba(255,90,90,.22);
  border-radius: 10px;
  padding: 9px 13px;
  background: rgba(255,75,75,.1);
  color: #ff8585;
  font: inherit;
  cursor: pointer;
}

.danger-button:hover:not(:disabled) {
  background: rgba(255,75,75,.18);
}

.danger-button:disabled {
  opacity: .4;
  cursor: not-allowed;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(5,7,12,.72);
  backdrop-filter: blur(8px);
}

.delete-modal {
  width: min(440px, 100%);
  padding: 26px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 20px;
  background: #171a22;
  box-shadow: 0 30px 90px rgba(0,0,0,.5);
}

.delete-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  margin-bottom: 18px;
  border-radius: 14px;
  background: rgba(167,139,250,.1);
  color: #b49aff;
  font-size: 25px;
}

.delete-content h2 {
  margin: 0 0 8px;
  color: #fff;
  font-size: 21px;
}

.delete-content p {
  margin: 0;
  color: #969ba8;
  line-height: 1.5;
}

.delete-filename {
  overflow: hidden;
  margin-top: 16px;
  padding: 11px 13px;
  border: 1px solid rgba(255,255,255,.07);
  border-radius: 10px;
  background: rgba(255,255,255,.035);
  color: #dfe2e9;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 24px;
}

.modal-delete {
  padding: 10px 15px;
}

/* ----------------------------------------------------------
   Medeor media viewer improvements
   ---------------------------------------------------------- */

.viewer-media {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  transform-origin: center center;
  transition: transform 120ms ease;
}

.viewer-zoom-controls {
  position: absolute;
  left: 18px;
  bottom: 18px;
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 5px;
  border-radius: 12px;
  background: rgba(12, 14, 20, 0.82);
  border: 1px solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  z-index: 5;
}

.viewer-zoom-value {
  min-width: 58px;
  border: 0;
  background: transparent;
  color: inherit;
  font-size: 12px;
  cursor: pointer;
  padding: 7px 8px;
}

.preview-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.preview-video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.preview-video-hidden {
  opacity: 0;
  pointer-events: none;
}

