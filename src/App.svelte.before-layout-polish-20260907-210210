                  <span class="playlist-picker-arrow">→</span>
                </button>
              {/each}
            </div>
          {/if}
        </div>

        <div class="organization-modal-footer">
          <button
            class="secondary-button"
            onclick={closeOrganizationEditors}
            disabled={playlistEditorBusy}
          >
            Cancel
          </button>
        </div>
      </div>
    </div>
  {/if}


  {#if deleteTarget || deleteTargets.length}
    <div
      class="modal-backdrop"
      role="presentation"
      onclick={(event) => {
        if (event.target === event.currentTarget) {
