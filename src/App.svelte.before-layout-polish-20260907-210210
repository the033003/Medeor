<script lang="ts">
  import { invoke, convertFileSrc } from "@tauri-apps/api/core";
  import { open } from "@tauri-apps/plugin-dialog";
  import { getCurrentWindow } from "@tauri-apps/api/window";

  type Page = "view" | "playlists" | "import";

  type Media = {
    id: number;
    path: string;
    name: string;
    media_type: string;
    size: number;
    added_at: string;
  };

  let page: Page = "view";
  let search = "";
  let media: Media[] = [];
  let loading = false;
  let error = "";
  let dragActive = false;

  let selectMode = false;
  let selectedIds = new Set<number>();
  let openMenuId: number | null = null;

  // data-medeor-tags-ux
  let editTagsMedia: Media | null = null;
  let tagEditorBusy = false;
  let playlistTargetMedia: Media | null = null;
  let playlistEditorBusy = false;

  async function openTagEditor(item: Media) {
    openMenuId = null;
    editTagsMedia = item;
    if (!tags.length) {
      await loadTags();
    }
  }

  async function toggleTagForMedia(tagId: number) {
    if (!editTagsMedia || tagEditorBusy) return;

    tagEditorBusy = true;
    error = "";

    try {
      // The backend currently exposes add/remove operations but not a
      // per-media tag listing. Add is therefore intentionally idempotent;
      // removal is available from the editor as an explicit action.
      await invoke("add_tag_to_media", {
        mediaId: editTagsMedia.id,
        tagId
      });
    } catch (e) {
      error = String(e);
    } finally {
      tagEditorBusy = false;
    }
  }

  async function removeTagForMedia(tagId: number) {
    if (!editTagsMedia || tagEditorBusy) return;

    tagEditorBusy = true;
    error = "";

    try {
      await invoke("remove_tag_from_media", {
        mediaId: editTagsMedia.id,
        tagId
      });
    } catch (e) {
      error = String(e);
    } finally {
      tagEditorBusy = false;
    }
  }

  async function openPlaylistEditor(item: Media) {
    openMenuId = null;
    playlistTargetMedia = item;

    if (!playlists.length) {
      await loadPlaylists();
    }
  }

  async function addMediaToPlaylist(playlistId: number) {
    if (!playlistTargetMedia || playlistEditorBusy) return;

    playlistEditorBusy = true;
    error = "";

    try {
      await invoke("add_to_playlist", {
        playlistId,
        mediaId: playlistTargetMedia.id
      });
      playlistTargetMedia = null;
    } catch (e) {
      error = String(e);
    } finally {
      playlistEditorBusy = false;
    }
  }

  function closeOrganizationEditors() {
    if (!tagEditorBusy && !playlistEditorBusy) {
      editTagsMedia = null;
      playlistTargetMedia = null;
    }
  }

  let videoPreviews: Record<number, string> = {};
  let viewerScale = 1;

  function handleViewerVideoError(event: Event) {
    const video = event.currentTarget as HTMLVideoElement;
    const mediaError = video.error;

    if (mediaError) {
      const messages: Record<number, string> = {
        1: "MEDIA_ERR_ABORTED",
        2: "MEDIA_ERR_NETWORK",
        3: "MEDIA_ERR_DECODE",
        4: "MEDIA_ERR_SRC_NOT_SUPPORTED"
      };

      error =
        `Video error: ${messages[mediaError.code] || `code ${mediaError.code}`} ` +
        `(${mediaError.message || "no additional message"})`;

      console.error("[Medeor viewer] Video error", {
        path: viewerItem?.path,
        code: mediaError.code,
        message: mediaError.message,
        networkState: video.networkState,
        readyState: video.readyState
      });
    } else {
      error = "Video failed to load.";
    }
  }

  function handleViewerVideoLoaded() {
    if (!viewerVideo) return;

    console.log("[Medeor viewer] Video loaded", {
      duration: viewerVideo.duration,
      width: viewerVideo.videoWidth,
      height: viewerVideo.videoHeight,
      readyState: viewerVideo.readyState
    });

    viewerDuration = Number.isFinite(viewerVideo.duration)
      ? viewerVideo.duration
      : 0;
  }

  function resetViewerZoom() {
    viewerScale = 1;
  }

  function zoomViewer(amount: number) {
    viewerScale = Math.max(0.25, Math.min(5, viewerScale + amount));
  }

  function captureVideoPreview(
    event: Event,
    id: number
  ) {
    const video = event.currentTarget as HTMLVideoElement;

    if (!video.videoWidth || !video.videoHeight) {
      return;
    }

    try {
      const canvas = document.createElement("canvas");
      const maxWidth = 640;
      const scale = Math.min(1, maxWidth / video.videoWidth);

      canvas.width = Math.max(1, Math.round(video.videoWidth * scale));
      canvas.height = Math.max(1, Math.round(video.videoHeight * scale));

      const context = canvas.getContext("2d");

      if (!context) {
        return;
      }

      context.drawImage(
        video,
        0,
        0,
        canvas.width,
        canvas.height
      );

      videoPreviews = {
        ...videoPreviews,
        [id]: canvas.toDataURL("image/jpeg", 0.78)
      };
    } catch {
      // Some WebKit configurations can reject canvas capture.
      // The video element remains as the fallback preview.
    }
  }



  let deleteTarget: Media | null = null;
  let deleteTargets: Media[] = [];

  let viewerVideo: HTMLVideoElement | null = null;
  let viewerPlaying = false;
  let viewerTime = 0;
  let viewerDuration = 0;
  let viewerVolume = 1;
  let viewerUrl = "";

  const params = new URLSearchParams(window.location.search);
  const viewerPath = params.get("viewer");

  let viewerItem: Media | null = viewerPath
    ? {
        id: 0,
        path: viewerPath,
        name: viewerPath.split("/").pop() || "Media",
        media_type: getMediaType(viewerPath),
        size: 0,
        added_at: ""
      }
    : null;

  $: filteredMedia = media;

  function getMediaType(path: string): string {
    const extension =
      path.split(".").pop()?.toLowerCase() || "";

    if (
      ["mp4", "webm", "mkv", "mov", "avi", "m4v", "wmv"].includes(extension)
    ) {
      return "video";
    }

    if (extension === "gif") return "gif";

    if (
      [
        "jpg",
        "jpeg",
        "png",
        "webp",
        "avif",
        "bmp",
        "svg",
        "heic",
        "heif"
      ].includes(extension)
    ) {
      return "image";
    }

    return "other";
  }


  const hoverPreviewTimers = new Map<number, number>();

  function previewVideoEnter(event: MouseEvent, item: Media) {
    if (item.media_type !== "video") return;

    const video = event.currentTarget as HTMLVideoElement;

    video.muted = true;
    video.currentTime = 0;

    const timer = window.setTimeout(() => {
      video.play().catch(() => {
        // Autoplay may be rejected by WebKit; the poster frame remains visible.
      });
    }, 80);

    hoverPreviewTimers.set(item.id, timer);
  }

  function previewVideoLeave(event: MouseEvent, item: Media) {
    if (item.media_type !== "video") return;

    const timer = hoverPreviewTimers.get(item.id);
    if (timer !== undefined) {
      window.clearTimeout(timer);
      hoverPreviewTimers.delete(item.id);
    }

    const video = event.currentTarget as HTMLVideoElement;

    video.pause();

    try {
      video.currentTime = 0;
    } catch {
      // Ignore videos that have not loaded enough metadata yet.
    }
  }

  function previewVideoLoaded(event: Event) {
    const video = event.currentTarget as HTMLVideoElement;

    if (!video.videoWidth || !video.videoHeight) return;

    // Start around one second in so the thumbnail is less likely
    // to be a black opening frame.
    if (video.duration > 1) {
      video.currentTime = Math.min(1, video.duration / 3);
    }
  }

  const mediaUrls = new Map<string, string>();

  function mediaSrc(path: string): string {
    const cached = mediaUrls.get(path);
    if (cached) return cached;

    const extension =
      path.split(".").pop()?.toLowerCase() || "";

    const videoExtensions = [
      "mp4",
      "webm",
      "mkv",
      "mov",
      "avi",
      "m4v",
      "wmv"
    ];

    let url: string;

    if (videoExtensions.includes(extension)) {
      // The Rust media server supports HTTP Range requests,
      // which is important for browser video previews.
      const encoded = encodeURIComponent(path);

      // The server port is exposed by the existing Tauri command.
      // This starts with a temporary placeholder; the async
      // initializer below replaces it once the port is known.
      url = "";
    } else {
      url = convertFileSrc(path);
    }

    mediaUrls.set(path, url);
    return url;
  }


  async function ensureMediaPreview(item: Media) {
    if (mediaUrls.has(item.path)) return;

    try {
      const port = await invoke<number>("media_server_port");
      const url =
        `http://127.0.0.1:${port}/media?path=` +
        encodeURIComponent(item.path);

      mediaUrls.set(item.path, url);
      media = [...media];
    } catch (e) {
      console.error("[Medeor] Could not load preview:", item.path, e);
    }
  }

  function mediaError(kind: string, path: string, event: Event) {
    console.error("[Medeor]", kind, "FAILED:", path, event);
  }

  function mediaLoaded(kind: string, path: string) {
    console.log(`[Medeor] ${kind} loaded:`, path);
  }

  function mediaFailed(kind: string, path: string, event: Event) {
    console.error(`[Medeor] ${kind} FAILED:`, path);
    console.error("  event:", event);

    const target = event.currentTarget as HTMLMediaElement | HTMLImageElement;

    if (target instanceof HTMLMediaElement) {
      console.error("  src:", target.src);
      console.error("  networkState:", target.networkState);
      console.error("  readyState:", target.readyState);
      console.error("  error:", target.error);
    } else {
      console.error("  src:", target.src);
    }
  }


  $: if (filteredMedia.length) {
    for (const item of filteredMedia) {
      if (
        item.media_type === "image" ||
        item.media_type === "gif" ||
        item.media_type === "video"
      ) {
        ensureMediaPreview(item);
      }
    }
  }

  async function loadMedia() {
    try {
      error = "";
      media = await invoke<Media[]>("list_media", { search });
    } catch (e) {
      error = String(e);
    }
  }

  async function chooseFiles() {
    try {
      error = "";

      const selected = await open({
        multiple: true,
        directory: false,
        filters: [
          {
            name: "Media",
            extensions: [
              "jpg", "jpeg", "png", "webp", "avif", "bmp",
              "gif", "heic", "heif",
              "mp4", "webm", "mkv", "mov", "avi", "m4v", "wmv"
            ]
          }
        ]
      });

      if (!selected) return;

      const paths = Array.isArray(selected) ? selected : [selected];

      await importFiles(paths);
    } catch (e) {
      error = String(e);
    }
  }

  async function importFiles(paths: string[]) {
    if (!paths.length) return;

    loading = true;
    error = "";

    try {
      media = await invoke<Media[]>("import_media", { paths });
      page = "view";
    } catch (e) {
      error = String(e);
    } finally {
      loading = false;
    }
  }

  async function openMedia(item: Media) {
    resetViewerZoom();
    try {
      await invoke("open_viewer", { path: item.path });
    } catch (e) {
      error = String(e);
    }
  }

  function toggleSelected(id: number) {
    const next = new Set(selectedIds);

    if (next.has(id)) {
      next.delete(id);
    } else {
      next.add(id);
    }

    selectedIds = next;
  }

  function selectAll() {
    selectedIds = new Set(filteredMedia.map((item) => item.id));
  }

  function cancelSelection() {
    selectedIds = new Set();
    selectMode = false;
  }

  function requestRemove(item: Media) {
    openMenuId = null;
    deleteTarget = item;
  }

  function requestRemoveSelected() {
    if (!selectedIds.size) return;

    deleteTargets = filteredMedia.filter((item) =>
      selectedIds.has(item.id)
    );
  }

  function cancelRemove() {
    deleteTarget = null;
    deleteTargets = [];
  }

  async function confirmRemove() {
    try {
      if (deleteTarget) {
        await invoke("remove_media", {
          id: deleteTarget.id
        });

        deleteTarget = null;
      }

      if (deleteTargets.length) {
        for (const item of deleteTargets) {
          await invoke("remove_media", {
            id: item.id
          });
        }

        deleteTargets = [];
        selectedIds = new Set();
        selectMode = false;
      }

      await loadMedia();
    } catch (e) {
      error = String(e);
      cancelRemove();
    }
  }

  async function setupNativeDrop() {
    try {
      const window = getCurrentWindow();

      await window.onDragDropEvent(async (event) => {
        if (event.payload.type === "over") {
          dragActive = true;
        }

        if (event.payload.type === "leave") {
          dragActive = false;
        }

        if (event.payload.type === "drop") {
          dragActive = false;
          await importFiles(event.payload.paths);
        }
      });
    } catch (e) {
      console.error("Native drag/drop setup failed:", e);
    }
  }

  function togglePlayback() {
    if (!viewerVideo) return;

    if (viewerVideo.paused) {
      viewerVideo.play();
    } else {
      viewerVideo.pause();
    }
  }

  function updateVideo() {
    if (!viewerVideo) return;

    viewerTime = viewerVideo.currentTime;
    viewerDuration = viewerVideo.duration || 0;
  }

  function seekVideo(event: Event) {
    if (!viewerVideo) return;

    const input = event.currentTarget as HTMLInputElement;
    viewerVideo.currentTime = Number(input.value);
  }

  function setVolume(event: Event) {
    if (!viewerVideo) return;

    const input = event.currentTarget as HTMLInputElement;
    viewerVolume = Number(input.value);
    viewerVideo.volume = viewerVolume;
  }

  async function fullscreen(element: HTMLElement) {
    try {
      if (document.fullscreenElement) {
        await document.exitFullscreen();
      } else {
        await element.requestFullscreen();
      }
    } catch (e) {
      console.error(e);
    }
  }

  function formatTime(seconds: number) {
    if (!Number.isFinite(seconds)) return "0:00";

    const minutes = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);

    return `${minutes}:${secs.toString().padStart(2, "0")}`;
  }

  function navigate(nextPage: Page) {
    page = nextPage;
  }

  function formatSize(bytes: number) {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    if (bytes < 1024 * 1024 * 1024) {
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    return `${(bytes / (1024 * 1024 * 1024)).toFixed(1)} GB`;
  }

  setupNativeDrop();

  if (!viewerItem) {
    loadMedia();
  } else {
    mediaSrc(viewerItem.path)
      .then((url) => {
        viewerUrl = url;
      })
      .catch((e) => {
        console.error("[Medeor] Viewer load failed:", e);
      });
  }

  // ============================================================
  // Tags + Playlists
  // ============================================================

  type Tag = {
    id: number;
    name: string;
  };

  type Playlist = {
    id: number;
    name: string;
    created_at: string;
  };

  let tags: Tag[] = [];
  let playlists: Playlist[] = [];

  let showTags = false;
  let showPlaylists = false;

  let newTagName = "";
  let newPlaylistName = "";

  let selectedTagId: number | null = null;
  let selectedPlaylistId: number | null = null;

  let tagsLoading = false;
  let playlistsLoading = false;

  async function loadTags() {
    tagsLoading = true;

    try {
      tags = await invoke<Tag[]>("list_tags");
    } catch (e) {
      error = String(e);
    } finally {
      tagsLoading = false;
    }
  }

  async function loadPlaylists() {
    playlistsLoading = true;

    try {
      playlists = await invoke<Playlist[]>("list_playlists");
    } catch (e) {
      error = String(e);
    } finally {
      playlistsLoading = false;
    }
  }

  async function createTagFromUi() {
    const name = newTagName.trim();

    if (!name) return;

    try {
      await invoke("create_tag", { name });
      newTagName = "";
      await loadTags();
    } catch (e) {
      error = String(e);
    }
  }

  async function deleteTagFromUi(id: number) {
    try {
      await invoke("delete_tag", { id });

      if (selectedTagId === id) {
        selectedTagId = null;
      }

      await loadTags();
    } catch (e) {
      error = String(e);
    }
  }

  async function createPlaylistFromUi() {
    const name = newPlaylistName.trim();

    if (!name) return;

    try {
      await invoke("create_playlist", { name });
      newPlaylistName = "";
      await loadPlaylists();
    } catch (e) {
      error = String(e);
    }
  }

  async function deletePlaylistFromUi(id: number) {
    try {
      await invoke("delete_playlist", { id });

      if (selectedPlaylistId === id) {
        selectedPlaylistId = null;
      }

      await loadPlaylists();
    } catch (e) {
      error = String(e);
    }
  }

  async function tagSelectedMedia() {
    if (selectedTagId === null || selectedIds.size === 0) return;

    try {
      for (const mediaId of selectedIds) {
        await invoke("add_tag_to_media", {
          mediaId,
          tagId: selectedTagId
        });
      }

      error = "";
    } catch (e) {
      error = String(e);
    }
  }

  async function untagSelectedMedia() {
    if (selectedTagId === null || selectedIds.size === 0) return;

    try {
      for (const mediaId of selectedIds) {
        await invoke("remove_tag_from_media", {
          mediaId,
          tagId: selectedTagId
        });
      }

      error = "";
    } catch (e) {
      error = String(e);
    }
  }

  async function addSelectedToPlaylist() {
    if (selectedPlaylistId === null || selectedIds.size === 0) return;

    try {
      for (const mediaId of selectedIds) {
        await invoke("add_to_playlist", {
          playlistId: selectedPlaylistId,
          mediaId
        });
      }

      error = "";
    } catch (e) {
      error = String(e);
    }
  }

  async function removeSelectedFromPlaylist() {
    if (selectedPlaylistId === null || selectedIds.size === 0) return;

    try {
      for (const mediaId of selectedIds) {
        await invoke("remove_from_playlist", {
          playlistId: selectedPlaylistId,
          mediaId
        });
      }

      error = "";
    } catch (e) {
      error = String(e);
    }
  }

  // Load these once when the library is initialized.
  loadTags();
  loadPlaylists();

</script>

<svelte:head>
  <title>{viewerItem ? viewerItem.name : "Medeor"}</title>
</svelte:head>

{#if viewerItem}
  <div class="viewer-window">
    <header class="viewer-header">
      <div class="viewer-heading">
        <strong>{viewerItem.name}</strong>
        <span>{viewerItem.media_type}</span>
      </div>
    </header>

    <main class="viewer-stage">
      {#if viewerItem.media_type === "video"}
        <video
          bind:this={viewerVideo}
          class="viewer-media"
          src={viewerUrl}
          preload="metadata"
          playsinline
          onclick={togglePlayback}
          ontimeupdate={updateVideo}
          onloadedmetadata={updateVideo}
          onplay={() => (viewerPlaying = true)}
          onpause={() => (viewerPlaying = false)}
        >
          <track kind="captions" srclang="en" label="Captions" />
        </video>

        <div class="viewer-controls">
          <button
            class="viewer-control"
            onclick={togglePlayback}
            aria-label="Play or pause"
          >
            {viewerPlaying ? "❚❚" : "▶"}
          </button>

          <span class="viewer-time">
            {formatTime(viewerTime)}
          </span>

          <input
            class="viewer-progress"
            type="range"
            min="0"
            max={viewerDuration || 0}
            step="0.1"
            value={viewerTime}
            oninput={seekVideo}
            aria-label="Video progress"
          />

          <span class="viewer-time">
            {formatTime(viewerDuration)}
          </span>

          <button
            class="viewer-control"
            onclick={() => {
              viewerVolume = viewerVolume > 0 ? 0 : 1;
              if (viewerVideo) viewerVideo.volume = viewerVolume;
            }}
            aria-label="Mute"
          >
            {viewerVolume === 0 ? "🔇" : "🔊"}
          </button>

          <input
            class="viewer-volume"
            type="range"
            min="0"
            max="1"
            step="0.01"
            value={viewerVolume}
            oninput={setVolume}
            aria-label="Volume"
          />

          <button
            class="viewer-control"
            onclick={(event) =>
              fullscreen(
                (event.currentTarget as HTMLElement).closest(
                  ".viewer-stage"
                ) as HTMLElement
              )}
            aria-label="Fullscreen"
          >
            ⛶
          </button>
        </div>
      {:else if viewerItem.media_type === "gif"}
        <img
          class="viewer-media"
          src={viewerUrl}
          alt={viewerItem.name}
          onload={() => mediaLoaded("VIEWER IMAGE", viewerItem.path)}
          onerror={(event) => mediaFailed("VIEWER IMAGE", viewerItem.path, event)}
        />

        <button
          class="viewer-floating-control"
          onclick={(event) =>
            fullscreen(
              (event.currentTarget as HTMLElement).closest(
                ".viewer-stage"
              ) as HTMLElement
            )}
        >
          ⛶
        </button>
      {:else if viewerItem.media_type === "image"}
        <img
          class="viewer-media"
          src={viewerUrl}
          alt={viewerItem.name}
          onload={() => mediaLoaded("VIEWER IMAGE", viewerItem.path)}
          onerror={(event) => mediaFailed("VIEWER IMAGE", viewerItem.path, event)}
        />

        <button
          class="viewer-floating-control"
          onclick={(event) =>
            fullscreen(
              (event.currentTarget as HTMLElement).closest(
                ".viewer-stage"
              ) as HTMLElement
            )}
        >
          ⛶
        </button>
      {:else}
        <div class="viewer-error">
          This media type cannot be previewed.
        </div>
      {/if}
    </main>
  </div>
{:else}
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-mark">☄</div>

        <div>
          <div class="brand-name">Medeor</div>
          <div class="brand-subtitle">media, made simple</div>
        </div>
      </div>

      <nav class="navigation" aria-label="Main navigation">
        <button
          class:active={page === "view"}
          class="nav-item"
          onclick={() => navigate("view")}
        >
          <span class="nav-icon">◉</span>
          <span>View</span>
        </button>

        <button
          class:active={page === "import"}
          class="nav-item"
          onclick={() => navigate("import")}
        >
          <span class="nav-icon">↓</span>
          <span>Import</span>
        </button>

        <button
          class:active={page === "playlists"}
          class="nav-item"
          onclick={() => {
            navigate("playlists");
            loadPlaylists();
          }}
        >
          <span class="nav-icon">♫</span>
          <span>Playlists</span>
        </button>
      </nav>

      <div class="sidebar-section">
        <div class="sidebar-heading">Library</div>

        <div class="library-count">
          <span>All media</span>
          <span class="tag-count">{media.length}</span>
        </div>
      </div>


      <div class="sidebar-section organization-section">
        <div class="sidebar-heading">Organize</div>

        <button
          class="organization-toggle"
          class:organization-active={showTags}
          onclick={() => {
            showTags = !showTags;
            if (showTags) loadTags();
          }}
        >
          <span>🏷</span>
          <span>Tags</span>
          <span class="organization-count">{tags.length}</span>
        </button>

