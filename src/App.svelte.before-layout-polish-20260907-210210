      >
        <div class="organization-modal-header">
          <div>
            <div class="organization-modal-eyebrow">ORGANIZE</div>
            <h2 id="playlist-title">Add to Playlist</h2>
            <p>{playlistTargetMedia.name}</p>
          </div>

