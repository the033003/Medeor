            </div>
          {/if}
        </div>

        <div class="modal-actions">
          <button class="secondary-button" onclick={cancelRemove}>
            Cancel
          </button>

          <button
            class="danger-button modal-delete"
            onclick={confirmRemove}
          >
            Remove from Library
          </button>
        </div>
      </div>
    </div>
  {/if}
{/if}


