          <span>♫</span>
          <span>Playlists</span>
          <span class="organization-count">{playlists.length}</span>
        </button>

        {#if showPlaylists}
          <div class="organization-panel">
            <div class="organization-create">
              <input
                bind:value={newPlaylistName}
                placeholder="New playlist..."
                aria-label="New playlist name"
                onkeydown={(event) => {
                  if (event.key === "Enter") createPlaylistFromUi();
                }}
              />

              <button
                class="organization-add"
                onclick={createPlaylistFromUi}
                disabled={!newPlaylistName.trim()}
              >
                +
              </button>
            </div>

            {#if playlistsLoading}
              <div class="organization-empty">Loading...</div>
            {:else if playlists.length === 0}
              <div class="organization-empty">No playlists yet.</div>
            {:else}
              <div class="organization-list">
                {#each playlists as playlist}
                  <div class="organization-row">
                    <button
                      class="organization-select"
                      class:organization-selected={selectedPlaylistId === playlist.id}
                      onclick={() => (selectedPlaylistId = playlist.id)}
                    >
                      {playlist.name}
                    </button>

                    <button
                      class="organization-delete"
                      title="Delete playlist"
                      aria-label={`Delete playlist ${playlist.name}`}
                      onclick={() => deletePlaylistFromUi(playlist.id)}
                    >
                      ×
                    </button>
                  </div>
                {/each}
              </div>
            {/if}

            <div class="organization-actions">
              <button
                class="secondary-button"
                onclick={addSelectedToPlaylist}
                disabled={
                  selectedPlaylistId === null || selectedIds.size === 0
                }
              >
                Add selected
              </button>

              <button
                class="secondary-button"
                onclick={removeSelectedFromPlaylist}
                disabled={
                  selectedPlaylistId === null || selectedIds.size === 0
                }
              >
                Remove selected
              </button>
            </div>
          </div>
        {/if}
      </div>

      <div class="sidebar-footer">
        <button class="settings-button">
          <span>⚙</span>
          <span>Settings</span>
        </button>
      </div>
    </aside>

    <main class="main">
      {#if page === "view"}
        <header class="topbar">
          <div>
            <div class="eyebrow">LIBRARY</div>
            <h1>View</h1>
          </div>

          <div class="search">
            <span class="search-icon">⌕</span>

            <input
              bind:value={search}
              placeholder="Search media..."
              aria-label="Search media"
            />

            <kbd>/</kbd>
          </div>
        </header>

        <section class="content">
          {#if error}
            <div class="error-banner">{error}</div>
          {/if}

          <div class="library-toolbar">
            {#if selectMode}
              <button class="secondary-button" onclick={selectAll}>
                Select All
              </button>

              <button
                class="danger-button"
                onclick={requestRemoveSelected}
                disabled={!selectedIds.size}
              >
                Remove Selected ({selectedIds.size})
              </button>

              <button class="secondary-button" onclick={cancelSelection}>
                Cancel
              </button>
            {:else}
              <button
                class="secondary-button"
                onclick={() => (selectMode = true)}
              >
                Select
              </button>
            {/if}
          </div>

          {#if filteredMedia.length === 0}
            <div class="empty-state">
              <div class="empty-orbit">
                <div class="empty-mark">☄</div>
              </div>

              <h2>Your library is empty</h2>

              <p>
                Drop some media into Medeor and start building your visual
                library.
              </p>

              <button
                class="primary-button"
                onclick={() => navigate("import")}
              >
                <span>↓</span>
                Import Media
              </button>
            </div>
          {:else}
            <div class="library-grid">
              {#each filteredMedia as item}
                {#if !mediaUrls.get(item.path)}{@const previewRequested = ensureMediaPreview(item)}{/if}
                <div
                  class:selected={selectedIds.has(item.id)}
                  class="media-card"
                  title={item.path}
                >
                  {#if selectMode}
                    <label class="selection-box">
                      <input
                        type="checkbox"
                        checked={selectedIds.has(item.id)}
                        onchange={() => toggleSelected(item.id)}
                      />
                    </label>
                  {/if}

                  <button
                    class="media-open"
                    onclick={() => {
                      if (selectMode) {
                        toggleSelected(item.id);
                      } else {
                        openMedia(item);
                      }
                    }}
                  >
                    <div class="media-preview">
                      {#if item.media_type === "video"}
                        {#if mediaUrls.get(item.path)}
                          <video
                            class="preview-video"
                            src={mediaUrls.get(item.path)}
                            preload="metadata"
                            muted
                            playsinline
                            loop
                            onloadedmetadata={previewVideoLoaded}
                            onmouseenter={(event) =>
                              previewVideoEnter(event, item)}
                            onmouseleave={(event) =>
                              previewVideoLeave(event, item)}
                            onerror={(event) =>
                              mediaFailed("THUMB VIDEO", item.path, event)}
                          ></video>
                        {:else}
                          <div class="media-type">▶</div>
                        {/if}

                        <div class="preview-play">▶</div>

                      {:else if item.media_type === "gif" || item.media_type === "image"}
                        {#if mediaUrls.get(item.path)}
                          <img
                            src={mediaUrls.get(item.path)}
                            alt={item.name}
                            loading="lazy"
                            onload={() => mediaLoaded("THUMB IMAGE", item.path)}
                            onerror={(event) =>
                              mediaFailed("THUMB IMAGE", item.path, event)}
                          />
                        {:else}
                          <div class="media-type">◇</div>
                        {/if}

                      {:else}
                        <div class="media-type">◇</div>
                      {/if}

                      <div class="media-hover-info">
                        <div class="media-name">{item.name}</div>
                        <div class="media-meta">
                          {item.media_type} · {formatSize(item.size)}
                        </div>
                      </div>
                    </div>
                  </button>

                  {#if !selectMode}
                    <div class="media-menu">
                      <button
                        class="menu-button"
                        aria-label="Media options"
                        onclick={(event) => {
                          event.stopPropagation();
                          openMenuId =
                            openMenuId === item.id
                              ? null
                              : item.id;
                        }}
                      >
                        ⋮
                      </button>

                      {#if openMenuId === item.id}
                        <div class="menu">
                          <button
                            onclick={() => requestRemove(item)}
                          >
                            Remove from Library
                          </button>

                          <button
                            onclick={() => openTagEditor(item)}
                          >
                            <span>🏷</span>
                            Edit Tags
                          </button>

                          <button
                            onclick={() => openPlaylistEditor(item)}
                          >
                            <span>♫</span>
                            Add to Playlist
                          </button>

                          <button disabled>
                            Rename
                          </button>

                          <button disabled>
                            File Info
                          </button>
                        </div>
                      {/if}
                    </div>
                  {/if}
                </div>
              {/each}
            </div>
          {/if}
        </section>
      {:else}
        <header class="topbar">
          <div>
            <div class="eyebrow">LIBRARY</div>
            <h1>Import Media</h1>
          </div>
        </header>

        <section class="content import-content">
          {#if error}
            <div class="error-banner">{error}</div>
          {/if}

          <div
            class:drag-active={dragActive}
            class="drop-zone"
            role="button"
            tabindex="0"
            aria-label="Drop media here"
            onclick={chooseFiles}
            onkeydown={(event) => {
              if (event.key === "Enter" || event.key === " ") {
                chooseFiles();
              }
            }}
          >
            <div class="drop-icon">↓</div>

            <h2>
              {loading ? "Importing..." : "Drop media here"}
            </h2>

            <p>
              Videos, images, GIFs, and other visual media.
            </p>

            <button
              class="secondary-button"
              onclick={(event) => {
                event.stopPropagation();
                chooseFiles();
              }}
              disabled={loading}
            >
              Browse Files
            </button>
          </div>

          <div class="import-note">
            <span class="note-icon">✦</span>

            <div>
              <strong>Your files stay where they are.</strong>

              <p>
                Medeor stores library metadata locally. Importing does not
                copy or move your media.
              </p>
            </div>
          </div>
        </section>
      {:else if page === "playlists"}
        <header class="topbar">
          <div>
            <div class="eyebrow">LIBRARY</div>
            <h1>Playlists</h1>
          </div>
        </header>

        <section class="content playlist-page">
          {#if error}
            <div class="error-banner">{error}</div>
          {/if}

          <div class="playlist-page-header">
            <div>
              <div class="playlist-page-title">Your playlists</div>
              <div class="playlist-page-subtitle">
                Choose a playlist to view its media.
              </div>
            </div>

            <div class="playlist-page-count">
              {playlists.length}
              {playlists.length === 1 ? "playlist" : "playlists"}
            </div>
          </div>

          {#if playlists.length === 0}
            <div class="empty-state">
              <div class="empty-orbit">
                <div class="empty-mark">♫</div>
              </div>

              <h2>No playlists yet</h2>

              <p>
                Create a playlist from the Organize section.
              </p>
            </div>
          {:else}
            <div class="playlist-page-list">
              {#each playlists as playlist}
                <button
                  class:selected={selectedPlaylistId === playlist.id}
                  class="playlist-page-item"
                  onclick={() => {
                    selectedPlaylistId =
                      selectedPlaylistId === playlist.id
                        ? null
                        : playlist.id;
                  }}
                >
                  <span class="playlist-page-icon">♫</span>

                  <span class="playlist-page-name">
                    {playlist.name}
                  </span>

                  <span class="playlist-page-arrow">
                    {selectedPlaylistId === playlist.id ? "⌄" : "›"}
                  </span>
                </button>
              {/each}
            </div>

            {#if selectedPlaylistId !== null}
              {@const selectedPlaylist = playlists.find(
                (playlist) => playlist.id === selectedPlaylistId
              )}

              {#if selectedPlaylist}
                <div class="playlist-media-section">
                  <div class="playlist-media-heading">
                    <div>
                      <div class="playlist-media-title">
                        {selectedPlaylist.name}
                      </div>
                      <div class="playlist-media-subtitle">
                        Media in this playlist
                      </div>
                    </div>
                  </div>

                  <div class="playlist-media-empty">
                    <div class="empty-mark">♫</div>
                    <strong>{selectedPlaylist.name}</strong>
                    <p>
                      Playlist selection is working. Media membership will
                      appear here once the playlist contents are loaded.
                    </p>
                  </div>
                </div>
              {/if}
            {/if}
          {/if}
        </section>

      {:else}      {/if}
    </main>
  </div>

  {#if editTagsMedia}
    <div
      class="organization-modal-backdrop"
      role="presentation"
      onclick={(event) => {
        if (event.target === event.currentTarget) closeOrganizationEditors();
      }}
    >
      <div
        class="organization-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="edit-tags-title"
