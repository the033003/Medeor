<script lang="ts">
  import { invoke, convertFileSrc } from "@tauri-apps/api/core";
  import { open } from "@tauri-apps/plugin-dialog";
  import { getCurrentWindow } from "@tauri-apps/api/window";

  type Page = "view" | "import";

  type Media = {
    id: number;
    path: string;
    name: string;
    media_type: string;
    size: number;
    added_at: string;
  }
  type PlaylistItem = {
    playlist_id: number;
    media_id: number;
    position: number;
  };
;

  let page: Page = "view";
  let search = "";
  let media: Media[] = [];
  let loading = false;
  let error = "";
  let dragActive = false;

  let selectMode = false;
  let selectedIds = new Set<number>();
  let openMenuId: number | null = null;

  // data-medeor-tags-ux
  let editTagsMedia: Media | null = null;
  let tagEditorBusy = false;
  let playlistTargetMedia: Media | null = null;
  let playlistEditorBusy = false;

  async function openTagEditor(item: Media) {
    openMenuId = null;
    editTagsMedia = item;
    if (!tags.length) {
      await loadTags();
    }
  }

  async function toggleTagForMedia(tagId: number) {
    if (!editTagsMedia || tagEditorBusy) return;

    tagEditorBusy = true;
    error = "";

    try {
      // The backend currently exposes add/remove operations but not a
      // per-media tag listing. Add is therefore intentionally idempotent;
      // removal is available from the editor as an explicit action.
      await invoke("add_tag_to_media", {
        mediaId: editTagsMedia.id,
        tagId
      });
    } catch (e) {
      error = String(e);
    } finally {
      tagEditorBusy = false;
    }
  }

  async function removeTagForMedia(tagId: number) {
    if (!editTagsMedia || tagEditorBusy) return;

    tagEditorBusy = true;
    error = "";

    try {
      await invoke("remove_tag_from_media", {
        mediaId: editTagsMedia.id,
        tagId
      });
    } catch (e) {
      error = String(e);
    } finally {
      tagEditorBusy = false;
    }
  }

  async function openPlaylistEditor(item: Media) {
    openMenuId = null;
    playlistTargetMedia = item;

    if (!playlists.length) {
      await loadPlaylists();
    }
  }

  async function addMediaToPlaylist(playlistId: number) {
    if (!playlistTargetMedia || playlistEditorBusy) return;

    playlistEditorBusy = true;
    error = "";

    try {
      await invoke("add_to_playlist", {
        playlistId,
        mediaId: playlistTargetMedia.id
      });
      playlistTargetMedia = null;
    } catch (e) {
      error = String(e);
    } finally {
      playlistEditorBusy = false;
    }
  }

  function closeOrganizationEditors() {
    if (!tagEditorBusy && !playlistEditorBusy) {
      editTagsMedia = null;
      playlistTargetMedia = null;
    }
  }

  let videoPreviews: Record<number, string> = {};
  let viewerScale = 1;

  function handleViewerVideoError(event: Event) {
    const video = event.currentTarget as HTMLVideoElement;
    const mediaError = video.error;

    if (mediaError) {
      const messages: Record<number, string> = {
        1: "MEDIA_ERR_ABORTED",
        2: "MEDIA_ERR_NETWORK",
        3: "MEDIA_ERR_DECODE",
        4: "MEDIA_ERR_SRC_NOT_SUPPORTED"
      };

      error =
        `Video error: ${messages[mediaError.code] || `code ${mediaError.code}`} ` +
        `(${mediaError.message || "no additional message"})`;

      console.error("[Medeor viewer] Video error", {
        path: viewerItem?.path,
        code: mediaError.code,
        message: mediaError.message,
        networkState: video.networkState,
        readyState: video.readyState
      });
    } else {
      error = "Video failed to load.";
    }
  }

  function handleViewerVideoLoaded() {
    if (!viewerVideo) return;

    console.log("[Medeor viewer] Video loaded", {
      duration: viewerVideo.duration,
      width: viewerVideo.videoWidth,
      height: viewerVideo.videoHeight,
      readyState: viewerVideo.readyState
    });

    viewerDuration = Number.isFinite(viewerVideo.duration)
      ? viewerVideo.duration
      : 0;
  }

  function resetViewerZoom() {
    viewerScale = 1;
  }

  function zoomViewer(amount: number) {
    viewerScale = Math.max(0.25, Math.min(5, viewerScale + amount));
  }

  function captureVideoPreview(
    event: Event,
    id: number
  ) {
    const video = event.currentTarget as HTMLVideoElement;

    if (!video.videoWidth || !video.videoHeight) {
      return;
    }

    try {
      const canvas = document.createElement("canvas");
      const maxWidth = 640;
      const scale = Math.min(1, maxWidth / video.videoWidth);

      canvas.width = Math.max(1, Math.round(video.videoWidth * scale));
      canvas.height = Math.max(1, Math.round(video.videoHeight * scale));

      const context = canvas.getContext("2d");

      if (!context) {
        return;
      }

      context.drawImage(
        video,
        0,
        0,
        canvas.width,
        canvas.height
      );

      videoPreviews = {
        ...videoPreviews,
        [id]: canvas.toDataURL("image/jpeg", 0.78)
      };
    } catch {
      // Some WebKit configurations can reject canvas capture.
      // The video element remains as the fallback preview.
    }
  }



  let deleteTarget: Media | null = null;
  let deleteTargets: Media[] = [];

  let viewerVideo: HTMLVideoElement | null = null;
  let viewerPlaying = false;
  let viewerTime = 0;
  let viewerDuration = 0;
  let viewerVolume = 1;
  let viewerUrl = "";

  const params = new URLSearchParams(window.location.search);
  const viewerPath = params.get("viewer");

  let viewerItem: Media | null = viewerPath
    ? {
        id: 0,
        path: viewerPath,
        name: viewerPath.split("/").pop() || "Media",
        media_type: getMediaType(viewerPath),
        size: 0,
        added_at: ""
      }
    : null;

  $: filteredMedia = media;

  function getMediaType(path: string): string {
    const extension =
      path.split(".").pop()?.toLowerCase() || "";

    if (
      ["mp4", "webm", "mkv", "mov", "avi", "m4v", "wmv"].includes(extension)
    ) {
      return "video";
    }

    if (extension === "gif") return "gif";

    if (
      [
        "jpg",
        "jpeg",
        "png",
        "webp",
        "avif",
        "bmp",
        "svg",
        "heic",
        "heif"
      ].includes(extension)
    ) {
      return "image";
    }

    return "other";
  }


  const hoverPreviewTimers = new Map<number, number>();

  function previewVideoEnter(event: MouseEvent, item: Media) {
    if (item.media_type !== "video") return;

    const video = event.currentTarget as HTMLVideoElement;

    video.muted = true;
    video.currentTime = 0;

    const timer = window.setTimeout(() => {
      video.play().catch(() => {
        // Autoplay may be rejected by WebKit; the poster frame remains visible.
      });
    }, 80);

    hoverPreviewTimers.set(item.id, timer);
  }

  function previewVideoLeave(event: MouseEvent, item: Media) {
    if (item.media_type !== "video") return;

    const timer = hoverPreviewTimers.get(item.id);
    if (timer !== undefined) {
      window.clearTimeout(timer);
      hoverPreviewTimers.delete(item.id);
    }

    const video = event.currentTarget as HTMLVideoElement;

    video.pause();

    try {
      video.currentTime = 0;
    } catch {
      // Ignore videos that have not loaded enough metadata yet.
    }
  }

  function previewVideoLoaded(event: Event) {
    const video = event.currentTarget as HTMLVideoElement;

    if (!video.videoWidth || !video.videoHeight) return;

    // Start around one second in so the thumbnail is less likely
    // to be a black opening frame.
    if (video.duration > 1) {
      video.currentTime = Math.min(1, video.duration / 3);
    }
  }

  const mediaUrls = new Map<string, string>();

  function mediaSrc(path: string): string {
    const cached = mediaUrls.get(path);
    if (cached) return cached;

    const extension =
      path.split(".").pop()?.toLowerCase() || "";

    const videoExtensions = [
      "mp4",
      "webm",
      "mkv",
      "mov",
      "avi",
      "m4v",
      "wmv"
    ];

    let url: string;

    if (videoExtensions.includes(extension)) {
      // The Rust media server supports HTTP Range requests,
      // which is important for browser video previews.
      const encoded = encodeURIComponent(path);

      // The server port is exposed by the existing Tauri command.
      // This starts with a temporary placeholder; the async
      // initializer below replaces it once the port is known.
      url = "";
    } else {
      url = convertFileSrc(path);
    }

    mediaUrls.set(path, url);
    return url;
  }


  async function ensureMediaPreview(item: Media) {
    if (mediaUrls.has(item.path)) return;

    try {
      const port = await invoke<number>("media_server_port");
      const url =
        `http://127.0.0.1:${port}/media?path=` +
        encodeURIComponent(item.path);

      mediaUrls.set(item.path, url);
      media = [...media];
    } catch (e) {
      console.error("[Medeor] Could not load preview:", item.path, e);
    }
  }

  function mediaError(kind: string, path: string, event: Event) {
    console.error("[Medeor]", kind, "FAILED:", path, event);
  }

  function mediaLoaded(kind: string, path: string) {
    console.log(`[Medeor] ${kind} loaded:`, path);
  }

  function mediaFailed(kind: string, path: string, event: Event) {
    console.error(`[Medeor] ${kind} FAILED:`, path);
    console.error("  event:", event);

    const target = event.currentTarget as HTMLMediaElement | HTMLImageElement;

    if (target instanceof HTMLMediaElement) {
      console.error("  src:", target.src);
      console.error("  networkState:", target.networkState);
      console.error("  readyState:", target.readyState);
      console.error("  error:", target.error);
    } else {
      console.error("  src:", target.src);
    }
  }


  $: if (filteredMedia.length) {
    for (const item of filteredMedia) {
      if (
        item.media_type === "image" ||
        item.media_type === "gif" ||
        item.media_type === "video"
      ) {
        ensureMediaPreview(item);
      }
    }
  }

  async function loadMedia() {
    try {
      error = "";
      media = await invoke<Media[]>("list_media", { search });
    } catch (e) {
      error = String(e);
    }
  }

  async function chooseFiles() {
    try {
      error = "";

      const selected = await open({
        multiple: true,
        directory: false,
        filters: [
          {
            name: "Media",
            extensions: [
              "jpg", "jpeg", "png", "webp", "avif", "bmp",
              "gif", "heic", "heif",
              "mp4", "webm", "mkv", "mov", "avi", "m4v", "wmv"
            ]
          }
        ]
      });

      if (!selected) return;

      const paths = Array.isArray(selected) ? selected : [selected];

      await importFiles(paths);
    } catch (e) {
      error = String(e);
    }
  }

  async function importFiles(paths: string[]) {
    if (!paths.length) return;

    loading = true;
    error = "";

    try {
      media = await invoke<Media[]>("import_media", { paths });
      page = "view";
    } catch (e) {
      error = String(e);
    } finally {
      loading = false;
    }
  }

  async function openMedia(item: Media) {
    resetViewerZoom();
    try {
      await invoke("open_viewer", { path: item.path });
    } catch (e) {
      error = String(e);
    }
  }

  function toggleSelected(id: number) {
    const next = new Set(selectedIds);

    if (next.has(id)) {
      next.delete(id);
    } else {
      next.add(id);
    }

    selectedIds = next;
  }

  function selectAll() {
    selectedIds = new Set(filteredMedia.map((item) => item.id));
  }

  function cancelSelection() {
    selectedIds = new Set();
    selectMode = false;
  }

  function requestRemove(item: Media) {
    openMenuId = null;
    deleteTarget = item;
  }

  function requestRemoveSelected() {
    if (!selectedIds.size) return;

    deleteTargets = filteredMedia.filter((item) =>
      selectedIds.has(item.id)
    );
  }

  function cancelRemove() {
    deleteTarget = null;
    deleteTargets = [];
  }

  async function confirmRemove() {
    try {
      if (deleteTarget) {
        await invoke("remove_media", {
          id: deleteTarget.id
        });

        deleteTarget = null;
      }

      if (deleteTargets.length) {
        for (const item of deleteTargets) {
          await invoke("remove_media", {
            id: item.id
          });
        }

        deleteTargets = [];
        selectedIds = new Set();
        selectMode = false;
      }

      await loadMedia();
    } catch (e) {
      error = String(e);
      cancelRemove();
    }
  }

  async function setupNativeDrop() {
    try {
      const window = getCurrentWindow();

      await window.onDragDropEvent(async (event) => {
        if (event.payload.type === "over") {
          dragActive = true;
        }

        if (event.payload.type === "leave") {
          dragActive = false;
        }

        if (event.payload.type === "drop") {
          dragActive = false;
          await importFiles(event.payload.paths);
        }
      });
    } catch (e) {
      console.error("Native drag/drop setup failed:", e);
    }
  }

  function togglePlayback() {
    if (!viewerVideo) return;

    if (viewerVideo.paused) {
      viewerVideo.play();
    } else {
      viewerVideo.pause();
    }
  }

  function updateVideo() {
    if (!viewerVideo) return;

    viewerTime = viewerVideo.currentTime;
    viewerDuration = viewerVideo.duration || 0;
  }

  function seekVideo(event: Event) {
    if (!viewerVideo) return;

    const input = event.currentTarget as HTMLInputElement;
    viewerVideo.currentTime = Number(input.value);
  }

  function setVolume(event: Event) {
    if (!viewerVideo) return;

    const input = event.currentTarget as HTMLInputElement;
    viewerVolume = Number(input.value);
    viewerVideo.volume = viewerVolume;
  }

  async function fullscreen(element: HTMLElement) {
    try {
      if (document.fullscreenElement) {
        await document.exitFullscreen();
      } else {
        await element.requestFullscreen();
      }
    } catch (e) {
      console.error(e);
    }
  }

  function formatTime(seconds: number) {
    if (!Number.isFinite(seconds)) return "0:00";

    const minutes = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);

    return `${minutes}:${secs.toString().padStart(2, "0")}`;
  }

  function navigate(nextPage: Page) {
    page = nextPage;
  }

  function formatSize(bytes: number) {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    if (bytes < 1024 * 1024 * 1024) {
      return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    }

    return `${(bytes / (1024 * 1024 * 1024)).toFixed(1)} GB`;
  }


  type Tag = {
    id: number;
    name: string;
  };

  type Playlist = {
    id: number;
    name: string;
    created_at: string;
  };

  type MediaOrganization = {
    media_id: number;
    tags: Tag[];
    playlists: Playlist[];
  };

  let tags: Tag[] = [];
  let playlists: Playlist[] = [];
  let mediaOrganization: Record<number, MediaOrganization> = {};

  let showTags = false;
  let showPlaylists = false;
  let showTagFilter = false;
  let selectedTagId: number | null = null;
  let selectedTagIds = new Set<number>();

  let organizationEditor: "tags" | "playlists" | null = null;
  let organizationMediaId: number | null = null;

  let importTagIds = new Set<number>();
  let importPlaylistIds = new Set<number>();
  let showImportOrganization = false;

  async function loadOrganization() {
    try {
      const [loadedTags, loadedPlaylists, organization] = await Promise.all([
        invoke<Tag[]>("list_tags"),
        invoke<Playlist[]>("list_playlists"),
        invoke<MediaOrganization[]>("list_media_organization")
      ]);

      tags = loadedTags;
      playlists = loadedPlaylists;

      const next: Record<number, MediaOrganization> = {};
      for (const item of organization) {
        next[item.media_id] = item;
      }

      mediaOrganization = next;
    } catch (e) {
      error = String(e);
    }
  }

  function organizationFor(id: number): MediaOrganization {
    return mediaOrganization[id] || {
      media_id: id,
      tags: [],
      playlists: []
    };
  }

  function filteredMedia() {
    if (selectedTagIds.size === 0) return media;

    return media.filter((item) => {
      const assigned = new Set(
        organizationFor(item.id).tags.map((tag) => tag.id)
      );

      for (const tagId of selectedTagIds) {
        if (!assigned.has(tagId)) return false;
      }

      return true;
    });
  }

  function openOrganizationEditor(
    mediaId: number,
    kind: "tags" | "playlists"
  ) {
    organizationMediaId = mediaId;
    organizationEditor = kind;
    openMenuId = null;
  }

  function closeOrganizationEditor() {
    organizationEditor = null;
    organizationMediaId = null;
  }

  async function toggleMediaTag(mediaId: number, tagId: number) {
    const current = organizationFor(mediaId);
    const ids = new Set(current.tags.map((tag) => tag.id));

    if (ids.has(tagId)) ids.delete(tagId);
    else ids.add(tagId);

    try {
      await invoke("set_media_tags", {
        mediaId,
        tagIds: [...ids]
      });

      await loadOrganization();
    } catch (e) {
      error = String(e);
    }
  }

  async function toggleMediaPlaylist(mediaId: number, playlistId: number) {
    const current = organizationFor(mediaId);
    const ids = new Set(current.playlists.map((playlist) => playlist.id));

    if (ids.has(playlistId)) ids.delete(playlistId);
    else ids.add(playlistId);

    try {
      await invoke("set_media_playlists", {
        mediaId,
        playlistIds: [...ids]
      });

      await loadOrganization();
    } catch (e) {
      error = String(e);
    }
  }

  function toggleFilterTag(tagId: number) {
    const next = new Set(selectedTagIds);

    if (next.has(tagId)) next.delete(tagId);
    else next.add(tagId);

    selectedTagIds = next;
    selectedTagId = selectedTagIds.size ? [...selectedTagIds][0] : null;
  }

  function clearTagFilter() {
    selectedTagIds = new Set();
    selectedTagId = null;
  }

  async function applyImportOrganization() {
    const ids = media.map((item) => item.id);

    if (!ids.length) return;

    try {
      await invoke("set_organization_for_media", {
        mediaIds: ids,
        tagIds: [...importTagIds],
        playlistIds: [...importPlaylistIds]
      });

      await loadOrganization();
      showImportOrganization = false;
      importTagIds = new Set();
      importPlaylistIds = new Set();
    } catch (e) {
      error = String(e);
    }
  }

  function toggleImportTag(tagId: number) {
    const next = new Set(importTagIds);

    if (next.has(tagId)) next.delete(tagId);
    else next.add(tagId);

    importTagIds = next;
  }

  function toggleImportPlaylist(playlistId: number) {
    const next = new Set(importPlaylistIds);

    if (next.has(playlistId)) next.delete(playlistId);
    else next.add(playlistId);

    importPlaylistIds = next;
  }

  setupNativeDrop();

  if (!viewerItem) {
    loadMedia();
  } else {
    mediaSrc(viewerItem.path)
      .then((url) => {
        viewerUrl = url;
      })
      .catch((e) => {
        console.error("[Medeor] Viewer load failed:", e);
      });
  }

  // ============================================================
  // Tags + Playlists
  // ============================================================

;

;

  let tags: Tag[] = [];
  let playlists: Playlist[] = [];

  let showTags = false;
  let showPlaylists = false;

  let newTagName = "";
  let newPlaylistName = "";

  let selectedTagId: number | null = null;
  let selectedPlaylistId: number | null = null;

  let tagsLoading = false;
  let playlistsLoading = false;

  async function loadTags() {
    tagsLoading = true;

    try {
      tags = await invoke<Tag[]>("list_tags");
    } catch (e) {
      error = String(e);
    } finally {
      tagsLoading = false;
    }
  }

  async function loadPlaylists() {
    playlistsLoading = true;

    try {
      playlists = await invoke<Playlist[]>("list_playlists");
    } catch (e) {
      error = String(e);
    } finally {
      playlistsLoading = false;
    }
  }

  async function createTagFromUi() {
    const name = newTagName.trim();

    if (!name) return;

    try {
      await invoke("create_tag", { name });
      newTagName = "";
      await loadTags();
    } catch (e) {
      error = String(e);
    }
  }

  async function deleteTagFromUi(id: number) {
    try {
      await invoke("delete_tag", { id });

      if (selectedTagId === id) {
        selectedTagId = null;
      }

      await loadTags();
    } catch (e) {
      error = String(e);
    }
  }

  async function createPlaylistFromUi() {
    const name = newPlaylistName.trim();

    if (!name) return;

    try {
      await invoke("create_playlist", { name });
      newPlaylistName = "";
      await loadPlaylists();
    } catch (e) {
      error = String(e);
    }
  }

  async function deletePlaylistFromUi(id: number) {
    try {
      await invoke("delete_playlist", { id });

      if (selectedPlaylistId === id) {
        selectedPlaylistId = null;
      }

      await loadPlaylists();
    } catch (e) {
      error = String(e);
    }
  }

  async function tagSelectedMedia() {
    if (selectedTagId === null || selectedIds.size === 0) return;

    try {
      for (const mediaId of selectedIds) {
        await invoke("add_tag_to_media", {
          mediaId,
          tagId: selectedTagId
        });
      }

      error = "";
    } catch (e) {
      error = String(e);
    }
  }

  async function untagSelectedMedia() {
    if (selectedTagId === null || selectedIds.size === 0) return;

    try {
      for (const mediaId of selectedIds) {
        await invoke("remove_tag_from_media", {
          mediaId,
          tagId: selectedTagId
        });
      }

      error = "";
    } catch (e) {
      error = String(e);
    }
  }

  async function addSelectedToPlaylist() {
    if (selectedPlaylistId === null || selectedIds.size === 0) return;

    try {
      for (const mediaId of selectedIds) {
        await invoke("add_to_playlist", {
          playlistId: selectedPlaylistId,
          mediaId
        });
      }

      error = "";
    } catch (e) {
      error = String(e);
    }
  }

  async function removeSelectedFromPlaylist() {
    if (selectedPlaylistId === null || selectedIds.size === 0) return;

    try {
      for (const mediaId of selectedIds) {
        await invoke("remove_from_playlist", {
          playlistId: selectedPlaylistId,
          mediaId
        });
      }

      error = "";
    } catch (e) {
      error = String(e);
    }
  }

  // Load these once when the library is initialized.
  loadTags();
  loadPlaylists();

</script>

<svelte:head>
  <title>{viewerItem ? viewerItem.name : "Medeor"}</title>
</svelte:head>

{#if viewerItem}
  <div class="viewer-window">
    <header class="viewer-header">
      <div class="viewer-heading">
        <strong>{viewerItem.name}</strong>
        <span>{viewerItem.media_type}</span>
      </div>
    </header>

    <main class="viewer-stage">
      {#if viewerItem.media_type === "video"}
        <video
          bind:this={viewerVideo}
          class="viewer-media"
          src={viewerUrl}
          preload="metadata"
          playsinline
          onclick={togglePlayback}
          ontimeupdate={updateVideo}
          onloadedmetadata={updateVideo}
          onplay={() => (viewerPlaying = true)}
          onpause={() => (viewerPlaying = false)}
        >
          <track kind="captions" srclang="en" label="Captions" />
        </video>

        <div class="viewer-controls">
          <button
            class="viewer-control"
            onclick={togglePlayback}
            aria-label="Play or pause"
          >
            {viewerPlaying ? "❚❚" : "▶"}
          </button>

          <span class="viewer-time">
            {formatTime(viewerTime)}
          </span>

          <input
            class="viewer-progress"
            type="range"
            min="0"
            max={viewerDuration || 0}
            step="0.1"
            value={viewerTime}
            oninput={seekVideo}
            aria-label="Video progress"
          />

          <span class="viewer-time">
            {formatTime(viewerDuration)}
          </span>

          <button
            class="viewer-control"
            onclick={() => {
              viewerVolume = viewerVolume > 0 ? 0 : 1;
              if (viewerVideo) viewerVideo.volume = viewerVolume;
            }}
            aria-label="Mute"
          >
            {viewerVolume === 0 ? "🔇" : "🔊"}
          </button>

          <input
            class="viewer-volume"
            type="range"
            min="0"
            max="1"
            step="0.01"
            value={viewerVolume}
            oninput={setVolume}
            aria-label="Volume"
          />

          <button
            class="viewer-control"
            onclick={(event) =>
              fullscreen(
                (event.currentTarget as HTMLElement).closest(
                  ".viewer-stage"
                ) as HTMLElement
              )}
            aria-label="Fullscreen"
          >
            ⛶
          </button>
        </div>
      {:else if viewerItem.media_type === "gif"}
        <img
          class="viewer-media"
          src={viewerUrl}
          alt={viewerItem.name}
          onload={() => mediaLoaded("VIEWER IMAGE", viewerItem.path)}
          onerror={(event) => mediaFailed("VIEWER IMAGE", viewerItem.path, event)}
        />

        <button
          class="viewer-floating-control"
          onclick={(event) =>
            fullscreen(
              (event.currentTarget as HTMLElement).closest(
                ".viewer-stage"
              ) as HTMLElement
            )}
        >
          ⛶
        </button>
      {:else if viewerItem.media_type === "image"}
        <img
          class="viewer-media"
          src={viewerUrl}
          alt={viewerItem.name}
          onload={() => mediaLoaded("VIEWER IMAGE", viewerItem.path)}
          onerror={(event) => mediaFailed("VIEWER IMAGE", viewerItem.path, event)}
        />

        <button
          class="viewer-floating-control"
          onclick={(event) =>
            fullscreen(
              (event.currentTarget as HTMLElement).closest(
                ".viewer-stage"
              ) as HTMLElement
            )}
        >
          ⛶
        </button>
      {:else}
        <div class="viewer-error">
          This media type cannot be previewed.
        </div>
      {/if}
    </main>
  </div>
{:else}
  <div class="app-shell">
    <aside class="sidebar">
      <div class="brand">
        <div class="brand-mark">☄</div>

        <div>
          <div class="brand-name">Medeor</div>
          <div class="brand-subtitle">media, made simple</div>
        </div>
      </div>

      <nav class="navigation" aria-label="Main navigation">
        <button
          class:active={page === "view"}
          class="nav-item"
          onclick={() => navigate("view")}
        >
          <span class="nav-icon">◉</span>
          <span>View</span>
        </button>

        <button
          class:active={page === "import"}
          class="nav-item"
          onclick={() => navigate("import")}
        >
          <span class="nav-icon">↓</span>
          <span>Import</span>
        </button>
      </nav>

      <div class="sidebar-section">
        <div class="sidebar-heading">Library</div>

        <div class="library-count">
          <span>All media</span>
          <span class="tag-count">{media.length}</span>
        </div>
      </div>


      <div class="sidebar-section organization-section">
        <div class="sidebar-heading">Organize</div>

        <button
          class="organization-toggle"
          class:organization-active={showTags}
          onclick={() => {
            showTags = !showTags;
            if (showTags) loadTags();
          }}
        >
          <span>🏷</span>
          <span>Tags</span>
          <span class="organization-count">{tags.length}</span>
        </button>

        {#if showTags}
          <div class="organization-panel">
            <div class="organization-create">
              <input
                bind:value={newTagName}
                placeholder="New tag..."
                aria-label="New tag name"
                onkeydown={(event) => {
                  if (event.key === "Enter") createTagFromUi();
                }}
              />

              <button
                class="organization-add"
                onclick={createTagFromUi}
                disabled={!newTagName.trim()}
              >
                +
              </button>
            </div>

            {#if tagsLoading}
              <div class="organization-empty">Loading...</div>
            {:else if tags.length === 0}
              <div class="organization-empty">No tags yet.</div>
            {:else}
              <div class="organization-list">
                {#each tags as tag}
                  <div class="organization-row">
                    <button
                      class="organization-select"
                      class:organization-selected={selectedTagId === tag.id}
                      onclick={() => (selectedTagId = tag.id)}
                    >
                      {tag.name}
                    </button>

                    <button
                      class="organization-delete"
                      title="Delete tag"
                      aria-label={`Delete tag ${tag.name}`}
                      onclick={() => deleteTagFromUi(tag.id)}
                    >
                      ×
                    </button>
                  </div>
                {/each}
              </div>
            {/if}

            <div class="organization-actions">
              <button
                class="secondary-button"
                onclick={tagSelectedMedia}
                disabled={selectedTagId === null || selectedIds.size === 0}
              >
                Tag selected
              </button>

              <button
                class="secondary-button"
                onclick={untagSelectedMedia}
                disabled={selectedTagId === null || selectedIds.size === 0}
              >
                Remove tag
              </button>
            </div>
          </div>
        {/if}

        <button
          class="organization-toggle"
          class:organization-active={showPlaylists}
          onclick={() => {
            showPlaylists = !showPlaylists;
            if (showPlaylists) loadPlaylists();
          }}
        >
          <span>♫</span>
          <span>Playlists</span>
          <span class="organization-count">{playlists.length}</span>
        </button>

        {#if showPlaylists}
          <div class="organization-panel">
            <div class="organization-create">
              <input
                bind:value={newPlaylistName}
                placeholder="New playlist..."
                aria-label="New playlist name"
                onkeydown={(event) => {
                  if (event.key === "Enter") createPlaylistFromUi();
                }}
              />

              <button
                class="organization-add"
                onclick={createPlaylistFromUi}
                disabled={!newPlaylistName.trim()}
              >
                +
              </button>
            </div>

            {#if playlistsLoading}
              <div class="organization-empty">Loading...</div>
            {:else if playlists.length === 0}
              <div class="organization-empty">No playlists yet.</div>
            {:else}
              <div class="organization-list">
                {#each playlists as playlist}
                  <div class="organization-row">
                    <button
                      class="organization-select"
                      class:organization-selected={selectedPlaylistId === playlist.id}
                      onclick={() => (selectedPlaylistId = playlist.id)}
                    >
                      {playlist.name}
                    </button>

                    <button
                      class="organization-delete"
                      title="Delete playlist"
                      aria-label={`Delete playlist ${playlist.name}`}
                      onclick={() => deletePlaylistFromUi(playlist.id)}
                    >
                      ×
                    </button>
                  </div>
                {/each}
              </div>
            {/if}

            <div class="organization-actions">
              <button
                class="secondary-button"
                onclick={addSelectedToPlaylist}
                disabled={
                  selectedPlaylistId === null || selectedIds.size === 0
                }
              >
                Add selected
              </button>

              <button
                class="secondary-button"
                onclick={removeSelectedFromPlaylist}
                disabled={
                  selectedPlaylistId === null || selectedIds.size === 0
                }
              >
                Remove selected
              </button>
            </div>
          </div>
        {/if}
      </div>


      <div class="sidebar-section tag-filter-section">
        <div class="sidebar-heading">Filter</div>

        <button
          class="organization-toggle"
          class:organization-active={showTagFilter}
          onclick={() => (showTagFilter = !showTagFilter)}
        >
          <span>⌕</span>
          <span>Filter by tags</span>
          {#if selectedTagIds.size}
            <span class="organization-count">{selectedTagIds.size}</span>
          {/if}
        </button>

        {#if showTagFilter}
          <div class="tag-filter-panel">
            {#if tags.length === 0}
              <div class="organization-empty">
                Create a tag to start filtering.
              </div>
            {:else}
              {#each tags as tag}
                <button
                  class="filter-tag-row"
                  class:filter-tag-selected={selectedTagIds.has(tag.id)}
                  onclick={() => toggleFilterTag(tag.id)}
                >
                  <span>{selectedTagIds.has(tag.id) ? "✓" : "○"}</span>
                  <span>{tag.name}</span>
                </button>
              {/each}

              {#if selectedTagIds.size}
                <button
                  class="filter-clear"
                  onclick={clearTagFilter}
                >
                  Clear filters
                </button>
              {/if}
            {/if}
          </div>
        {/if}
      </div>

      <div class="sidebar-footer">
        <button class="settings-button">
          <span>⚙</span>
          <span>Settings</span>
        </button>
      </div>
    </aside>

    <main class="main">
      {#if page === "view"}
        <header class="topbar">
          <div>
            <div class="eyebrow">LIBRARY</div>
            <h1>View</h1>
          </div>

          <div class="search">
            <span class="search-icon">⌕</span>

            <input
              bind:value={search}
              placeholder="Search media..."
              aria-label="Search media"
            />

            <kbd>/</kbd>
          </div>
        </header>

        <section class="content">
          {#if error}
            <div class="error-banner">{error}</div>
          {/if}

          <div class="library-toolbar">
            {#if selectMode}
              <button class="secondary-button" onclick={selectAll}>
                Select All
              </button>

              <button
                class="danger-button"
                onclick={requestRemoveSelected}
                disabled={!selectedIds.size}
              >
                Remove Selected ({selectedIds.size})
              </button>

              <button class="secondary-button" onclick={cancelSelection}>
                Cancel
              </button>
            {:else}
              <button
                class="secondary-button"
                onclick={() => (selectMode = true)}
              >
                Select
              </button>
            {/if}
          </div>

          {#if filteredMedia.length === 0}
            <div class="empty-state">
              <div class="empty-orbit">
                <div class="empty-mark">☄</div>
              </div>

              <h2>Your library is empty</h2>

              <p>
                Drop some media into Medeor and start building your visual
                library.
              </p>

              <button
                class="primary-button"
                onclick={() => navigate("import")}
              >
                <span>↓</span>
                Import Media
              </button>
            </div>
          {:else}
            <div class="library-grid">
              {#each filteredMedia as item}
                {#if !mediaUrls.get(item.path)}{@const previewRequested = ensureMediaPreview(item)}{/if}
                <div
                  class:selected={selectedIds.has(item.id)}
                  class="media-card"
                  title={item.path}
                >
                  {#if selectMode}
                    <label class="selection-box">
                      <input
                        type="checkbox"
                        checked={selectedIds.has(item.id)}
                        onchange={() => toggleSelected(item.id)}
                      />
                    </label>
                  {/if}

                  <button
                    class="media-open"
                    onclick={() => {
                      if (selectMode) {
                        toggleSelected(item.id);
                      } else {
                        openMedia(item);
                      }
                    }}
                  >
                    <div class="media-preview">
                      {#if item.media_type === "video"}
                        {#if mediaUrls.get(item.path)}
                          <video
                            class="preview-video"
                            src={mediaUrls.get(item.path)}
                            preload="metadata"
                            muted
                            playsinline
                            loop
                            onloadedmetadata={previewVideoLoaded}
                            onmouseenter={(event) =>
                              previewVideoEnter(event, item)}
                            onmouseleave={(event) =>
                              previewVideoLeave(event, item)}
                            onerror={(event) =>
                              mediaFailed("THUMB VIDEO", item.path, event)}
                          ></video>
                        {:else}
                          <div class="media-type">▶</div>
                        {/if}

                        <div class="preview-play">▶</div>

                      {:else if item.media_type === "gif" || item.media_type === "image"}
                        {#if mediaUrls.get(item.path)}
                          <img
                            src={mediaUrls.get(item.path)}
                            alt={item.name}
                            loading="lazy"
                            onload={() => mediaLoaded("THUMB IMAGE", item.path)}
                            onerror={(event) =>
                              mediaFailed("THUMB IMAGE", item.path, event)}
                          />
                        {:else}
                          <div class="media-type">◇</div>
                        {/if}

                      {:else}
                        <div class="media-type">◇</div>
                      {/if}

                      <div class="media-hover-info">
                        {#if organizationFor(item).tags.length || organizationFor(item).playlists.length}
                          <div class="organization-badges">
                            {#each organizationFor(item).tags.slice(0, 3) as tag}
                              <span class="organization-badge tag-badge">
                                #{tag.name}
                              </span>
                            {/each}

                            {#if organizationFor(item).tags.length > 3}
                              <span class="organization-badge muted-badge">
                                +{organizationFor(item).tags.length - 3}
                              </span>
                            {/if}

                            {#if organizationFor(item).playlists.length}
                              <span class="organization-badge playlist-badge">
                                ♫ {organizationFor(item).playlists[0].name}
                              </span>
                            {/if}
                          </div>
                        {/if}
                        <div class="media-name">{item.name}</div>
                        <div class="media-meta">
                          {item.media_type} · {formatSize(item.size)}
                        </div>
                        {#if organizationFor(item.id).tags.length || organizationFor(item.id).playlists.length}
                          <div class="organization-hover">
                            {#each organizationFor(item.id).tags.slice(0, 3) as tag}
                              <span class="media-tag-chip">#{tag.name}</span>
                            {/each}

                            {#if organizationFor(item.id).tags.length > 3}
                              <span class="media-tag-more">
                                +{organizationFor(item.id).tags.length - 3}
                              </span>
                            {/if}

                            {#if organizationFor(item.id).playlists.length}
                              <span class="media-playlist-chip">
                                ♫ {organizationFor(item.id).playlists[0].name}
                              </span>
                            {/if}
                          </div>
                        {/if}

                      </div>
                    </div>
                  </button>

                  {#if !selectMode}
                    <div class="media-menu">
                      <button
                        class="menu-button"
                        aria-label="Media options"
                        onclick={(event) => {
                          event.stopPropagation();
                          openMenuId =
                            openMenuId === item.id
                              ? null
                              : item.id;
                        }}
                      >
                        ⋮
                      </button>

                      {#if openMenuId === item.id}
                        <div class="menu">
                          <button
                            onclick={() => requestRemove(item)}
                          >
                            Remove from Library
                          </button>

                          <button
                            onclick={() => openTagEditor(item)}
                          >
                            <span>🏷</span>
                            Edit Tags
                          </button>

                          <button
                            onclick={() => openPlaylistEditor(item)}
                          >
                            <span>♫</span>
                            Add to Playlist
                          </button>

                          <button disabled>
                            Rename
                          </button>

                          <button disabled>
                            File Info
                          </button>
                        </div>
                      {/if}
                    </div>
                  {/if}
                </div>
              {/each}
            </div>
          {/if}
        </section>
      {:else}
        <header class="topbar">
          <div>
            <div class="eyebrow">LIBRARY</div>
            <h1>Import Media</h1>
          </div>
        </header>

        <section class="content import-content">
          {#if error}
            <div class="error-banner">{error}</div>
          {/if}

          <div
            class:drag-active={dragActive}
            class="drop-zone"
            role="button"
            tabindex="0"
            aria-label="Drop media here"
            onclick={chooseFiles}
            onkeydown={(event) => {
              if (event.key === "Enter" || event.key === " ") {
                chooseFiles();
              }
            }}
          >
            <div class="drop-icon">↓</div>

            <h2>
              {loading ? "Importing..." : "Drop media here"}
            </h2>

            <p>
              Videos, images, GIFs, and other visual media.
            </p>

            <button
              class="secondary-button"
              onclick={(event) => {
                event.stopPropagation();
                chooseFiles();
              }}
              disabled={loading}
            >
              Browse Files
            </button>
          </div>


          {#if media.length > 0}
            <div class="import-organization-card">
              <div class="import-organization-heading">
                <div>
                  <strong>Organize this import</strong>
                  <p>
                    Apply tags and playlists to everything imported in this batch.
                  </p>
                </div>

                <button
                  class="secondary-button"
                  onclick={() => showImportOrganization = !showImportOrganization}
                >
                  {showImportOrganization ? "Hide options" : "Set options"}
                </button>
              </div>

              {#if showImportOrganization}
                <div class="import-organization-options">
                  <div>
                    <div class="organization-option-heading">Tags</div>

                    <div class="import-option-list">
                      {#each tags as tag}
                        <button
                          class="import-option"
                          class:import-option-selected={importTagIds.has(tag.id)}
                          onclick={() => toggleImportTag(tag.id)}
                        >
                          {importTagIds.has(tag.id) ? "✓" : "○"}
                          #{tag.name}
                        </button>
                      {/each}

                      {#if tags.length === 0}
                        <span class="organization-empty">
                          No tags available.
                        </span>
                      {/if}
                    </div>
                  </div>

                  <div>
                    <div class="organization-option-heading">Playlists</div>

                    <div class="import-option-list">
                      {#each playlists as playlist}
                        <button
                          class="import-option"
                          class:import-option-selected={importPlaylistIds.has(playlist.id)}
                          onclick={() => toggleImportPlaylist(playlist.id)}
                        >
                          {importPlaylistIds.has(playlist.id) ? "✓" : "○"}
                          ♫ {playlist.name}
                        </button>
                      {/each}

                      {#if playlists.length === 0}
                        <span class="organization-empty">
                          No playlists available.
                        </span>
                      {/if}
                    </div>
                  </div>

                  <div class="import-organization-actions">
                    <button
                      class="secondary-button"
                      onclick={applyImportOrganization}
                      disabled={!importTagIds.size && !importPlaylistIds.size}
                    >
                      Apply to {media.length} item{media.length === 1 ? "" : "s"}
                    </button>
                  </div>
                </div>
              {/if}
            </div>
          {/if}

          <div class="import-note">
            <span class="note-icon">✦</span>

            <div>
              <strong>Your files stay where they are.</strong>

              <p>
                Medeor stores library metadata locally. Importing does not
                copy or move your media.
              </p>
            </div>
          </div>
        </section>
      {/if}
    </main>
  </div>

  {#if editTagsMedia}
    <div
      class="organization-modal-backdrop"
      role="presentation"
      onclick={(event) => {
        if (event.target === event.currentTarget) closeOrganizationEditors();
      }}
    >
      <div
        class="organization-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="edit-tags-title"
        data-medeor-tags-ux
      >
        <div class="organization-modal-header">
          <div>
            <div class="organization-modal-eyebrow">ORGANIZE</div>
            <h2 id="edit-tags-title">Edit Tags</h2>
            <p>{editTagsMedia.name}</p>
          </div>

          <button
            class="organization-modal-close"
            aria-label="Close tag editor"
            onclick={closeOrganizationEditors}
          >
            ×
          </button>
        </div>

        <div class="organization-modal-body">
          {#if tagsLoading}
            <div class="organization-modal-empty">Loading tags…</div>
          {:else if tags.length === 0}
            <div class="organization-modal-empty">
              <div class="organization-empty-icon">🏷</div>
              <strong>No tags yet</strong>
              <span>Create your first tag in the Organize section.</span>
            </div>
          {:else}
            <div class="organization-tag-grid">
              {#each tags as tag}
                <div class="organization-tag-row">
                  <span class="organization-tag-name">
                    <span class="organization-tag-dot"></span>
                    {tag.name}
                  </span>

                  <div class="organization-tag-actions">
                    <button
                      class="tag-action-button tag-add-button"
                      disabled={tagEditorBusy}
                      onclick={() => toggleTagForMedia(tag.id)}
                    >
                      Add
                    </button>

                    <button
                      class="tag-action-button tag-remove-button"
                      disabled={tagEditorBusy}
                      onclick={() => removeTagForMedia(tag.id)}
                    >
                      Remove
                    </button>
                  </div>
                </div>
              {/each}
            </div>
          {/if}

          <p class="organization-modal-hint">
            Add or remove tags from this media item without entering selection mode.
          </p>
        </div>

        <div class="organization-modal-footer">
          <button
            class="secondary-button"
            onclick={closeOrganizationEditors}
            disabled={tagEditorBusy}
          >
            Done
          </button>
        </div>
      </div>
    </div>
  {/if}

  {#if playlistTargetMedia}
    <div
      class="organization-modal-backdrop"
      role="presentation"
      onclick={(event) => {
        if (event.target === event.currentTarget) closeOrganizationEditors();
      }}
    >
      <div
        class="organization-modal playlist-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="playlist-title"
        data-medeor-tags-ux
      >
        <div class="organization-modal-header">
          <div>
            <div class="organization-modal-eyebrow">ORGANIZE</div>
            <h2 id="playlist-title">Add to Playlist</h2>
            <p>{playlistTargetMedia.name}</p>
          </div>

          <button
            class="organization-modal-close"
            aria-label="Close playlist picker"
            onclick={closeOrganizationEditors}
          >
            ×
          </button>
        </div>

        <div class="organization-modal-body">
          {#if playlists.length === 0}
            <div class="organization-modal-empty">
              <div class="organization-empty-icon">♫</div>
              <strong>No playlists yet</strong>
              <span>Create a playlist from the Organize section first.</span>
            </div>
          {:else}
            <div class="playlist-picker">
              {#each playlists as playlist}
                <button
                  class="playlist-picker-item"
                  disabled={playlistEditorBusy}
                  onclick={() => addMediaToPlaylist(playlist.id)}
                >
                  <span class="playlist-picker-icon">♫</span>
                  <span class="playlist-picker-name">{playlist.name}</span>
                  <span class="playlist-picker-arrow">→</span>
                </button>
              {/each}
            </div>
          {/if}
        </div>

        <div class="organization-modal-footer">
          <button
            class="secondary-button"
            onclick={closeOrganizationEditors}
            disabled={playlistEditorBusy}
          >
            Cancel
          </button>
        </div>
      </div>
    </div>
  {/if}



  {#if organizationEditor && organizationMediaId !== null}
    <div
      class="organization-editor-backdrop"
      role="presentation"
      onclick={(event) => {
        if (event.target === event.currentTarget) {
          closeOrganizationEditor();
        }
      }}
    >
      <div class="organization-editor" role="dialog" aria-modal="true">
        <div class="organization-editor-header">
          <div>
